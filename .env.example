# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# Google Analytics 4 Measurement ID (e.g. "G-XXXXXXXXXX"). Create a GA4 property at
# analytics.google.com, add a Web data stream for this domain, and paste its Measurement ID
# here. Leave blank to ship with analytics fully disabled (no script loads, all track()
# calls in src/lib/analytics.ts are silent no-ops).
PUBLIC_GA_MEASUREMENT_ID=

# Contact form (src/pages/api/contact.ts) sends via Gmail SMTP through nodemailer.
# GMAIL_USER: the Gmail address the form sends FROM (myaccount.google.com/apppasswords).
# GMAIL_APP_PASSWORD: a 16-character Google App Password for that account -- NOT your normal
# Gmail password (App Passwords require 2-Step Verification to be enabled on the account).
# Generate one at myaccount.google.com/apppasswords, name it e.g. "Concrete Estimate Pro",
# and paste the generated value here (and in Vercel's Project Settings -> Environment
# Variables for production -- never commit the real value, .env is gitignored).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Address contact-form submissions are delivered TO. Defaults to amitsharma00261@gmail.com
# in code if left blank, but setting it explicitly here/in Vercel is clearer.
CONTACT_TO_EMAIL=amitsharma00261@gmail.com
