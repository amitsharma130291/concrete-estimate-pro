---
export interface Crumb {
  label: string;
  href: string;
}
export interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
const site = Astro.site ?? new URL("https://concreteestimatepro.com");

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.label,
    item: new URL(item.href, site).toString(),
  })),
};
---

<nav aria-label="Breadcrumb" class="mx-auto max-w-7xl px-4 pt-4 sm:px-6">
  <ol class="flex flex-wrap items-center gap-1.5 text-xs text-muted">
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i === items.length - 1 ? (
          <span aria-current="page" class="font-medium text-ink">{item.label}</span>
        ) : (
          <a href={item.href} class="hover:text-orange">{item.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
