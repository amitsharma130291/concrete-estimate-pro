---
const navItems = [
  { label: "Calculators", href: "/calculators" },
  { label: "Features", href: "/concrete-estimating-software#features" },
  { label: "Pricing", href: "/pricing" },
  { label: "FAQ", href: "/concrete-estimating-software#faq" },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-white no-print">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="shrink-0">
      <span class="sr-only">Concrete Cost Pro home</span>
      <img src="/brand/logo-header.png" alt="Concrete Cost Pro" class="h-8 w-auto sm:h-9" width="614" height="100" />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-6 md:flex">
      {navItems.map((item) => (
        <a href={item.href} class="text-sm font-medium text-muted transition hover:text-ink">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-4 md:flex">
      <a
        href="/pricing"
        class="inline-flex items-center gap-2 rounded-lg bg-orange px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-orange-dark"
      >
        $79 Launch Price
      </a>
      <span class="text-xs leading-tight text-muted">
        Calculate Costs.<br />Protect Profits.
      </span>
    </div>

    <details class="relative md:hidden">
      <summary class="flex cursor-pointer list-none items-center rounded-lg border border-border p-2 text-ink [&::-webkit-details-marker]:hidden">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
        </svg>
        <span class="sr-only">Open menu</span>
      </summary>
      <div class="absolute right-0 top-12 w-56 rounded-xl border border-border bg-white p-3 shadow-xl">
        <nav aria-label="Mobile" class="flex flex-col gap-1">
          {navItems.map((item) => (
            <a href={item.href} class="rounded-lg px-3 py-2.5 text-sm font-medium text-ink hover:bg-warm-white">
              {item.label}
            </a>
          ))}
          <a href="/pricing" class="mt-1 rounded-lg bg-orange px-3 py-2.5 text-center text-sm font-semibold text-white hover:bg-orange-dark">
            $79 Launch Price
          </a>
        </nav>
      </div>
    </details>
  </div>
</header>
