---
const navItems = [
  { label: "Calculators", href: "/calculators" },
  { label: "Features", href: "/concrete-estimating-software#features" },
  { label: "Pricing", href: "/pricing" },
  { label: "FAQ", href: "/concrete-estimating-software#faq" },
];
---

<header class="sticky top-0 z-50 border-b border-charcoal-light bg-charcoal text-white no-print">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="shrink-0">
      <span class="sr-only">Concrete Estimate Pro home</span>
      <span class="inline-flex items-center gap-2 font-bold">
        <svg width="26" height="26" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path
            d="M20 2C9.9 2 2 9.9 2 20s7.9 18 18 18 18-7.9 18-18S30.1 2 20 2zm0 6.5c6.4 0 11.5 5.1 11.5 11.5S26.4 31.5 20 31.5c-3 0-5.7-1.1-7.8-3l4.6-4.6c.9.6 2 1 3.2 1 3.3 0 6-2.7 6-6s-2.7-6-6-6c-1.2 0-2.3.4-3.2 1l-4.6-4.6c2.1-1.9 4.8-3 7.8-3z"
            fill="#FF5A1F"></path>
        </svg>
        <span class="text-lg text-white">Concrete Estimate <span class="text-orange">Pro</span></span>
      </span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-6 md:flex">
      {navItems.map((item) => (
        <a href={item.href} class="text-sm font-medium text-white/85 transition hover:text-white">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-4 md:flex">
      <a
        href="/pricing"
        class="inline-flex items-center gap-2 rounded-lg bg-orange px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-orange-dark"
      >
        $99 Lifetime
      </a>
      <span class="text-xs leading-tight text-white/60">
        Build Smarter.<br />Quote Confidently.
      </span>
    </div>

    <details class="relative md:hidden">
      <summary class="flex cursor-pointer list-none items-center rounded-lg border border-white/20 p-2 text-white [&::-webkit-details-marker]:hidden">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
        </svg>
        <span class="sr-only">Open menu</span>
      </summary>
      <div class="absolute right-0 top-12 w-56 rounded-xl border border-charcoal-light bg-charcoal p-3 shadow-xl">
        <nav aria-label="Mobile" class="flex flex-col gap-1">
          {navItems.map((item) => (
            <a href={item.href} class="rounded-lg px-3 py-2.5 text-sm font-medium text-white/85 hover:bg-charcoal-light hover:text-white">
              {item.label}
            </a>
          ))}
          <a href="/pricing" class="mt-1 rounded-lg bg-orange px-3 py-2.5 text-center text-sm font-semibold text-white hover:bg-orange-dark">
            $99 Lifetime
          </a>
        </nav>
      </div>
    </details>
  </div>
</header>
