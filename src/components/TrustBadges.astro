---
export interface Props {
  items?: string[];
  align?: "center" | "left";
  class?: string;
}
const {
  items = [
    "No sign-up required",
    "Free calculators, forever",
    "One-time payment for Pro, no subscription",
    "Your data stays on your device",
  ],
  align = "center",
  class: className = "",
} = Astro.props;
const alignClass = align === "left" ? "justify-start" : "mx-auto max-w-3xl justify-center";
---

<ul class={`flex flex-wrap items-center gap-x-6 gap-y-2.5 text-sm text-muted ${alignClass} ${className}`}>
  {items.map((item) => (
    <li class="flex items-center gap-1.5">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0 text-green" aria-hidden="true">
        <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      {item}
    </li>
  ))}
</ul>
