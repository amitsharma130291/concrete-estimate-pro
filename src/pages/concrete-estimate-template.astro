---
import Layout from "../layouts/Layout.astro";
import PublicHeader from "../components/PublicHeader.astro";
import PublicFooter from "../components/PublicFooter.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import TrustBadges from "../components/TrustBadges.astro";
import EstimateTemplateIsland from "../components/calculator/EstimateTemplateIsland";
import { CALCULATOR_CONFIGS } from "../data/calculatorConfigs";

const faqs = [
  {
    q: "Is this an estimate template, a quote template or an invoice template?",
    a: "It works as all three — the same line-item builder produces an estimate, a quote or, once the job is complete and you change the heading, an invoice. Fill in the fields once and print or save whichever document you need.",
  },
  {
    q: "Can I print or save this as a PDF?",
    a: "Yes — the Print / Save as PDF button opens your browser's print dialog with a clean, customer-ready layout. Choose \"Save as PDF\" as the destination to download it.",
  },
  {
    q: "Does this save my estimate?",
    a: "This free template doesn't save data between visits. Concrete Cost Pro saves every estimate, lets you duplicate past projects, and generates line items automatically from your saved rates and dimensions.",
  },
  {
    q: "Can I use this for other trades?",
    a: "It's built for concrete flatwork, but the line-item format works for any straightforward estimate — add or remove lines as needed.",
  },
];

const goodEstimateFactors = [
  {
    title: "Specific scope, not vague scope",
    body: "\"80 ft × 18 ft driveway, 4in thick, broom finish\" leaves far less room for dispute later than \"driveway replacement.\" Specificity protects you as much as it informs the customer.",
  },
  {
    title: "Line-item clarity",
    body: "Breaking out materials, labor and equipment (even at a summary level) builds more trust than a single lump-sum number — customers are less likely to push back on a total they can see the shape of.",
  },
  {
    title: "Explicit exclusions",
    body: "State what's not included — permits, excess spoil removal, landscaping repair — in writing, before the job starts. This is the single easiest way to avoid a scope argument mid-project.",
  },
  {
    title: "A validity period",
    body: "Material prices move. An estimate that's good for 30 days protects you from a customer accepting three months later at a price that no longer covers your costs.",
  },
  {
    title: "Consistent numbering",
    body: "A simple estimate number (EST-1001, EST-1002...) makes it trivial to track which quote turned into which job, especially once you're running more than a handful at a time.",
  },
];

const webApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Concrete Estimate Template",
  url: "https://concretecostpro.com/concrete-estimate-template",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (web browser)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description: "Free interactive concrete estimate, quote and invoice template. Fill in your project and line items and print a customer-ready document in minutes.",
};
---

<Layout
  title="Concrete Estimate Template | Concrete Cost Pro"
  description="Free interactive concrete estimate template — also works as a concrete quote template or invoice template. Fill in your project and line items and print a customer-ready document in minutes."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webApplicationSchema)} />
  </Fragment>
  <PublicHeader />
  <main>
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Calculators", href: "/calculators" },
        { label: "Estimate Template", href: "/concrete-estimate-template" },
      ]}
    />

    <section class="border-b border-border bg-white no-print">
      <div class="mx-auto max-w-7xl px-4 pb-5 pt-5 sm:px-6 sm:pb-6 sm:pt-6">
        <h1 class="text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">Concrete Estimate Template</h1>
        <p class="mt-1.5 max-w-2xl text-base text-muted">
          An interactive concrete estimate template that doubles as a quote template or invoice template. Fill in
          your project details and line items on the left — a customer-ready document builds itself on the right.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8">
      <EstimateTemplateIsland client:load />
    </section>

    <section class="border-y border-border bg-white no-print">
      <div class="mx-auto max-w-7xl px-4 py-5 sm:px-6">
        <TrustBadges />
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-4 py-14 no-print sm:px-6">
      <h2 class="text-2xl font-bold text-ink">What makes a concrete estimate hold up</h2>
      <p class="mt-2 text-muted">
        A clear, complete estimate protects you from scope disputes as much as it helps the customer say yes. A few
        things worth getting right before you hit print.
      </p>
      <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
        {goodEstimateFactors.map((f) => (
          <div>
            <h3 class="font-semibold text-ink">{f.title}</h3>
            <p class="mt-1 text-sm text-muted">{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-14 no-print sm:px-6">
      <FaqAccordion faqs={faqs} />
    </section>

    <section class="border-t border-border bg-white no-print">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
        <h2 class="text-xl font-bold text-ink">Related concrete calculators</h2>
        <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {Object.values(CALCULATOR_CONFIGS).map((c) => (
            <a
              href={`/${c.slug}`}
              class="rounded-lg border border-border bg-warm-white px-4 py-3 text-sm font-medium text-ink transition hover:border-orange hover:text-orange"
            >
              {c.h1}
            </a>
          ))}
          <a
            href="/concrete-job-cost-calculator"
            class="rounded-lg border border-border bg-warm-white px-4 py-3 text-sm font-medium text-ink transition hover:border-orange hover:text-orange"
          >
            Concrete Job Cost Calculator
          </a>
        </div>
      </div>
    </section>

    <section class="bg-charcoal no-print">
      <div class="mx-auto max-w-4xl px-4 py-14 text-center sm:px-6">
        <h2 class="text-2xl font-bold text-white sm:text-3xl">Stop building estimates from scratch</h2>
        <p class="mx-auto mt-3 max-w-xl text-white/70">
          Concrete Cost Pro fills in line items automatically from your dimensions and saved rates — and keeps
          every estimate for next time.
        </p>
        <p class="mt-4 text-sm text-orange-ondark">
          <span class="text-white/55 line-through">$99</span> $79 launch price — locks in for good, one time only
        </p>
        <a
          href="/pricing"
          data-analytics-event="pro_cta_clicked"
          data-analytics-source="estimate_template"
          class="mt-3 inline-flex items-center justify-center rounded-lg bg-orange px-6 py-3.5 text-base font-semibold text-white transition hover:bg-orange-dark"
        >
          Get Concrete Cost Pro — $79 Launch Price
        </a>
      </div>
    </section>
  </main>
  <PublicFooter />
</Layout>
