---
import Layout from "../layouts/Layout.astro";
import PublicHeader from "../components/PublicHeader.astro";
import PublicFooter from "../components/PublicFooter.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import TrustBadges from "../components/TrustBadges.astro";
import JobCostCalculatorIsland from "../components/calculator/JobCostCalculatorIsland";
import { CALCULATOR_CONFIGS } from "../data/calculatorConfigs";
import { CheckCircle2, ArrowRight } from "lucide-react";

const proBenefits = [
  "Saved materials, labor and equipment rates",
  "Rate Health audit and required-price solver",
  "Estimate vs. actual, so you know if a job type is chronically underpriced",
  "Branded PDFs, CSV export, JSON backup",
];

const faqs = [
  {
    q: "How is this different from the cost calculators?",
    a: "The cost calculators start from dimensions (length, width, thickness) and compute concrete quantity for you. This job cost calculator is for when you already know your total costs; enter them directly to see true cost, margin and the price you need to charge.",
  },
  {
    q: "Can I use this as a concrete labor cost calculator?",
    a: "Yes. Enter your labor cost on its own to see how it factors into direct cost, overhead and true cost, then see the margin impact of a labor-only change.",
  },
  {
    q: "What's the difference between margin and markup?",
    a: "Margin is profit divided by selling price. Markup is profit divided by cost. A 30% margin requires a larger markup than 30%; this calculator always solves for margin, since that's what determines your actual profit on the invoice total.",
  },
  {
    q: "What should I include in overhead?",
    a: "Overhead covers costs that aren't tied to one job: insurance, office costs, vehicle costs, admin time. Many contractors express it as a percentage of direct job cost; set whatever percentage reflects your business.",
  },
];

const costFactors = [
  {
    title: "Overhead allocation",
    body: "How much of your fixed business costs (insurance, office, vehicles, admin time) you spread across each job changes your true cost more than most contractors expect. A too-low overhead percentage quietly erodes profit across every job you price.",
  },
  {
    title: "Target margin, not markup",
    body: "Pricing off markup instead of margin is a common, costly mix-up. A 30% markup on a $10,000 true cost prices at $13,000: a 23% margin, not 30%. This tool always solves for margin.",
  },
  {
    title: "Equipment and pump rental",
    body: "Pump rental, saws and other equipment are often the most volatile line item job to job. Price them per job rather than folding them into a flat average.",
  },
  {
    title: "Labor accuracy",
    body: "The gap between estimated and actual labor hours is where a lot of contractors lose margin without realizing it. Logging actuals over time (Concrete Cost Pro's Actuals tab) shows whether your labor assumptions run optimistic.",
  },
  {
    title: "Material price volatility",
    body: "Ready-mix and rebar prices can shift month to month. If you're quoting from memory instead of a current supplier price, you're pricing yesterday's costs.",
  },
];

const webApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Concrete Job Cost Calculator",
  url: "https://concretecostpro.com/concrete-job-cost-calculator",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (web browser)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description: "Enter your known concrete job costs, including as a standalone concrete labor cost calculator, to calculate true cost, overhead, target-margin pricing and required selling price.",
};
---

<Layout
  title="Concrete Job Cost Calculator | Concrete Cost Pro"
  description="Enter your known concrete job costs, including as a standalone concrete labor cost calculator, to calculate true cost, overhead, target-margin pricing and required selling price."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webApplicationSchema)} />
  </Fragment>
  <PublicHeader />
  <main>
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Calculators", href: "/calculators" },
        { label: "Job Cost Calculator", href: "/concrete-job-cost-calculator" },
      ]}
    />

    <section class="border-b border-border bg-white">
      <div class="mx-auto max-w-7xl px-4 pb-5 pt-5 sm:px-6 sm:pb-6 sm:pt-6">
        <h1 class="text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">Concrete Job Cost Calculator</h1>
        <p class="mt-1.5 max-w-2xl text-base text-muted">
          Already know your costs? Enter them directly: materials, labor, equipment, or just labor on its own as a
          concrete labor cost calculator, to see your true job cost, current margin and the price you need to
          charge to hit your target.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8">
      <JobCostCalculatorIsland client:load />
    </section>

    <section class="border-y border-border bg-white">
      <div class="mx-auto max-w-7xl px-4 py-5 sm:px-6">
        <TrustBadges />
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
      <h2 class="text-2xl font-bold text-ink">What actually moves your true job cost</h2>
      <p class="mt-2 text-muted">
        Job costing is only useful if the inputs are right. These are the places contractors most often under- or
        over-price without realizing it.
      </p>
      <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
        {costFactors.map((f) => (
          <div>
            <h3 class="font-semibold text-ink">{f.title}</h3>
            <p class="mt-1 text-sm text-muted">{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="border-t border-border bg-white">
      <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
        <h2 class="text-xl font-bold text-ink">How this calculator works</h2>
        <ol class="mt-4 flex flex-col gap-3 text-sm text-muted">
          <li class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-orange/10 text-xs font-bold text-orange">1</span>
            <span><strong class="text-ink">Direct cost:</strong> every cost line (ready mix, labor, forms, reinforcement, pump, equipment, other) is added together.</span>
          </li>
          <li class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-orange/10 text-xs font-bold text-orange">2</span>
            <span><strong class="text-ink">True cost:</strong> your overhead percentage is applied on top of direct cost.</span>
          </li>
          <li class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-orange/10 text-xs font-bold text-orange">3</span>
            <span><strong class="text-ink">Required price:</strong> solved so that (price − true cost) ÷ price equals your target margin, not markup.</span>
          </li>
          <li class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-orange/10 text-xs font-bold text-orange">4</span>
            <span><strong class="text-ink">Current margin:</strong> recalculated live against whatever selling price you enter, so you can see the gap instantly.</span>
          </li>
        </ol>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
      <FaqAccordion faqs={faqs} />
    </section>

    <section class="border-t border-border bg-white">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
        <h2 class="text-xl font-bold text-ink">Related concrete calculators</h2>
        <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {Object.values(CALCULATOR_CONFIGS).map((c) => (
            <a
              href={`/${c.slug}`}
              class="rounded-lg border border-border bg-warm-white px-4 py-3 text-sm font-medium text-ink transition hover:border-orange hover:text-orange"
            >
              {c.h1}
            </a>
          ))}
          <a
            href="/concrete-estimate-template"
            class="rounded-lg border border-border bg-warm-white px-4 py-3 text-sm font-medium text-ink transition hover:border-orange hover:text-orange"
          >
            Concrete Estimate Template
          </a>
        </div>
      </div>
    </section>

    <section class="border-t border-border bg-charcoal">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
        <div class="grid gap-10 lg:grid-cols-[1.05fr_1fr] lg:items-center">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-orange-ondark">For contractors running the business</p>
            <h2 class="mt-2 text-2xl font-extrabold text-white sm:text-3xl">Track true cost on every job, automatically</h2>
            <p class="mt-3 max-w-xl text-white/70">
              Concrete Cost Pro saves your rates so job costing takes seconds, then compares your estimate to actual
              results after the job is done.
            </p>
            <ul class="mt-6 flex flex-col gap-2.5 text-sm text-white/85">
              {proBenefits.map((item) => (
                <li class="flex items-start gap-2.5">
                  <CheckCircle2 size={17} strokeWidth={2.25} className="mt-0.5 shrink-0 text-orange-ondark" aria-hidden="true" />
                  {item}
                </li>
              ))}
            </ul>
            <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
              <a
                href="/pricing"
                data-pricing-cta
                data-analytics-event="pro_cta_clicked"
                data-analytics-source="job_cost_calculator"
                class="inline-flex items-center gap-2 rounded-lg bg-orange px-6 py-3.5 text-base font-semibold text-white transition hover:bg-orange-dark"
              >
                <span data-pricing-cta-label>Get Concrete Cost Pro — $79 Launch Price</span>
                <ArrowRight size={18} aria-hidden="true" />
              </a>
              <span class="text-sm text-white/55">No subscription · No account · 14-day refund</span>
            </div>
          </div>
          <div class="overflow-hidden rounded-xl border border-white/10 shadow-2xl">
            <div class="flex items-center gap-1.5 border-b border-white/10 bg-charcoal-light px-3 py-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-red/60" aria-hidden="true"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-amber/60" aria-hidden="true"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-green/60" aria-hidden="true"></span>
            </div>
            <img
              src="/guide/09-estimate-summary.png"
              alt="Branded customer estimate document next to an internal cost, overhead and margin panel"
              loading="lazy"
              class="w-full"
            />
          </div>
        </div>
      </div>
    </section>
  </main>
  <PublicFooter />
</Layout>
