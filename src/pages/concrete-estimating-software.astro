  <script>
    // Sticky purchase bar: hidden while the hero is in view, shown once scrolled past it.
    const hero = document.getElementById("hero");
    const bar = document.getElementById("sticky-purchase-bar");
    if (hero && bar) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          bar.hidden = entry.isIntersecting;
        },
        { rootMargin: "-72px 0px 0px 0px" },
      );
      observer.observe(hero);
    }

    // Interactive workflow tour: one visible panel + image at a time, swapped by step button.
    const tour = document.querySelector("[data-workflow-tour]");
    if (tour) {
      const buttons = tour.querySelectorAll<HTMLButtonElement>("[data-step-button]");
      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const step = btn.dataset.stepButton;
          buttons.forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
          tour.querySelectorAll<HTMLElement>("[data-step-panel]").forEach((el) => {
            el.hidden = el.dataset.stepPanel !== step;
          });
          tour.querySelectorAll<HTMLImageElement>("[data-step-image]").forEach((el) => {
            el.hidden = el.dataset.stepImage !== step;
          });
        });
      });
    }
  </script>
