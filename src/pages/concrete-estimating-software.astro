---
import Layout from "../layouts/Layout.astro";
import PublicHeader from "../components/PublicHeader.astro";
import PublicFooter from "../components/PublicFooter.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import TrustBadges from "../components/TrustBadges.astro";
import {
  CheckCircle2, ArrowRight, Check, X, Wallet, Layers, LayoutGrid, Clock, Target,
  FileStack, CopyPlus, SlidersHorizontal, FileText, GitCompare, BarChart3, DatabaseBackup,
} from "lucide-react";

// Hero product mockup -- a coded recreation of the real app's estimate panel (same
// ResultRow/Badge styling as ProjectCalculatorIsland.tsx and RateHealthTab.tsx), not a raw
// screenshot, so it can show one deliberately chosen, labeled example project. Math verified
// against src/lib/calc.ts: trueCost / (1 - targetMargin) = 8729 / 0.70 = 12,470.00 exactly.
const heroExample = {
  project: "Smith Driveway",
  quantityYd3: 16,
  trueCost: 8729,
  targetMarginPercent: 30,
  requiredPrice: 12470,
};

// Problem-section comparison. Both cards are labeled "Example" -- illustrative, not a real
// job. Guesswork card: sellingPrice $10,500 at 18% margin implies trueCost = 10500*(1-0.18) =
// $8,610, consistent with a $1,120 forgotten-overhead component. True-cost card matches the
// hero's own verified numbers.
const guesswork = { price: 10500, forgottenOverhead: 1120, actualMarginPercent: 18 };
const trueCostCard = { trueCost: 8729, targetMarginPercent: 30, requiredPrice: 12470 };

const workflowSteps = [
  {
    n: 1,
    title: "Enter the job",
    body: "Add dimensions and combine multiple slabs, driveway sections, patios, aprons, sidewalks or footings into one project.",
    img: "/guide/06-wizard-dimensions.png",
    alt: "Wizard step showing project dimensions entry for length, width and thickness",
  },
  {
    n: 2,
    title: "Apply your costs",
    body: "Pull in your saved concrete, reinforcement, labor, formwork, equipment, delivery and overhead rates instead of retyping them.",
    img: "/guide/07-wizard-costs.png",
    alt: "Wizard step showing material, labor and equipment cost entry pulled from saved rates",
  },
  {
    n: 3,
    title: "Price for your margin",
    body: "See true job cost and the exact selling price required to hit your target margin, not a rough markup guess.",
    img: "/guide/08-wizard-price.png",
    alt: "Wizard step showing true cost, target margin and required selling price",
  },
  {
    n: 4,
    title: "Send and learn",
    body: "Create a customer-ready estimate, then log actual costs afterward to see where future pricing needs adjusting.",
    img: "/guide/09-estimate-summary.png",
    alt: "Branded customer estimate document next to an internal cost, overhead and margin panel",
  },
];

// Illustrative Rate Health rows -- example templates, not a real customer's saved rates.
// Target margin 35% matches this feature's default target-margin workspace setting.
const rateHealthRows = [
  { name: "Basic slab", margin: 38.9, status: "healthy" },
  { name: "Driveway", margin: 36.4, status: "healthy" },
  { name: "Patio", margin: 38.0, status: "healthy" },
  { name: "Stamped", margin: 25.3, status: "review" },
];

// Illustrative cost-change scenario. Grounded in the real Rate Health feature
// (src/components/app/tabs/RateHealthTab.tsx), which re-prices every saved template against a
// hypothetical rate change and counts how many fall below target margin -- it does not touch
// "open estimates" (the app keeps exactly one current estimate, never an archive; see
// src/lib/persistence.ts's model comment), so that concept doesn't apply here.
const scenario = { from: 165, to: 185, templatesChecked: 6, nowBelowTarget: 3 };

// Estimated-vs-actual example, continuing the same "Smith Driveway" project as the hero.
// Verified: at the hero's $12,470 selling price, actual cost $9,980 gives a margin of
// (12470-9980)/12470 = 19.97%, which rounds to 20%.
const estVsActual = {
  estimated: { concreteYd3: 16, laborHours: 52, cost: 8729, marginPercent: 30 },
  actual: { concreteYd3: 17.2, laborHours: 61, cost: 9980, marginPercent: 20 },
};

const featureGrid = [
  { icon: Wallet, title: "Saved business costs", body: "Enter your ready-mix, labor, equipment and overhead rates once, reuse them on every job." },
  { icon: Layers, title: "Material and equipment catalog", body: "Keep a running list of the rates you actually pay, ready to pull into any project." },
  { icon: LayoutGrid, title: "Multi-section projects", body: "Combine a driveway, an apron and a sidewalk into a single job estimate." },
  { icon: Clock, title: "Hourly or unit-based labor", body: "Price a crew by the hour or by the square foot, whichever matches how you actually bid." },
  { icon: Target, title: "Overhead and target-margin pricing", body: "True cost includes your overhead, and the required price is solved for the margin you set." },
  { icon: FileStack, title: "Reusable project templates", body: "Save a standard slab, driveway or patio setup once and start every similar job from it." },
  { icon: CopyPlus, title: "Project duplication", body: "Start a new estimate from a close match instead of building every job from zero." },
  { icon: SlidersHorizontal, title: "Cost-change scenarios", body: "Test a material or labor rate increase against your saved templates before it hits a real quote." },
  { icon: FileText, title: "Branded customer estimates", body: "Hand off a clean, professional document with your company details, scope and pricing." },
  { icon: GitCompare, title: "Estimate-versus-actual tracking", body: "Log what a job actually cost and compare it against what you estimated." },
  { icon: BarChart3, title: "Historical profitability", body: "See margin trends across past jobs instead of guessing which job types run thin." },
  { icon: DatabaseBackup, title: "CSV export and workspace backup", body: "Pull your numbers into a spreadsheet, or export a full backup you control." },
];

const comparison = [
  { label: "Cost", free: "Free", pro: "$79 once" },
  { label: "Concrete quantity and cost calculations", free: true, pro: true },
  { label: "Solve for a target-margin selling price", free: "One project at a time", pro: "Saved as your default, every job" },
  { label: "Save material, labor and equipment rates", free: false, pro: true },
  { label: "Multi-section projects", free: false, pro: true },
  { label: "Reusable project templates", free: false, pro: true },
  { label: "Project duplication", free: false, pro: true },
  { label: "Rate Health audit across your standard rates", free: false, pro: true },
  { label: "Material, labor and equipment cost-change scenarios", free: false, pro: true },
  { label: "Branded, customer-ready estimate PDF", free: "Basic template", pro: "Branded, with company details" },
  { label: "Estimate-versus-actual tracking", free: false, pro: true },
  { label: "CSV export", free: false, pro: true },
  { label: "Workspace backup and restore", free: false, pro: true },
];

const builtFor = [
  "Owner-operated concrete companies",
  "Residential concrete contractors",
  "Flatwork contractors",
  "Contractors pricing slabs, driveways, patios, sidewalks and similar pours",
  "Estimators who already know the required project specifications",
];

const notBuiltFor = [
  "Automatic blueprint or PDF takeoff",
  "Structural design",
  "Engineering decisions",
  "Building-code determination",
  "Enterprise scheduling, CRM, accounting, payroll or dispatch",
];

const faqs = [
  {
    q: "Is this a monthly subscription?",
    a: "No. Concrete Cost Pro is a single one-time purchase: $79 at the current launch price, regularly $99, with no recurring billing.",
  },
  {
    q: "Does it calculate concrete quantity?",
    a: "Yes. Enter dimensions and it converts them to cubic yards, with your order allowance added, the same math the free calculators use, plus everything below.",
  },
  {
    q: "Can I use my own material and labor costs?",
    a: "Yes. Save your ready-mix, labor, forms, reinforcement, equipment and overhead rates once, then reuse them on every estimate instead of retyping them.",
  },
  {
    q: "Can I estimate projects with multiple sections?",
    a: "Yes. Combine slabs, driveway sections, patios, aprons, sidewalks and footings into a single project estimate.",
  },
  {
    q: "Can I create a customer-ready estimate?",
    a: "Yes. Build a branded estimate document with your company details, scope and customer-visible pricing. Your internal cost and margin numbers stay private unless you choose to show them.",
  },
  {
    q: "Does it track estimated versus actual costs?",
    a: "Yes. Log what a job actually cost after it wraps and compare it to your original estimate, so you can see which job types are consistently under- or over-estimated.",
  },
  {
    q: "Where is my data stored, and can I back it up?",
    a: "Everything lives in this browser's local storage on this device only, there's no account and no cloud sync. Settings → Export business data downloads a JSON file covering your business profile, catalog, rates and templates, importable on another device. Local storage isn't automatically backed up anywhere, so export regularly if you want a copy you control.",
  },
  {
    q: "Does the software determine slab thickness or structural requirements?",
    a: "Concrete Cost Pro does not provide engineering, structural-design, or building-code recommendations. The contractor supplies the project dimensions, thickness, reinforcement, strength, and other job specifications. The application calculates quantities, costs, margins, and prices from those inputs.",
  },
  {
    q: "Why not just use a spreadsheet?",
    a: "You can, and plenty of contractors start there. What a spreadsheet doesn't do on its own: catch a forgotten overhead line before you send the quote, warn you when a standing rate has drifted below your target margin, or hold a reusable template per job type without you rebuilding formulas each time. Concrete Cost Pro is that spreadsheet's math, already built and reusable.",
  },
  {
    q: "Is this concrete takeoff software?",
    a: "No. Concrete Cost Pro is manual quantity and cost estimating software for project dimensions you already know. It does not read blueprints or PDF plans automatically.",
  },
  {
    q: "Is this the same as concrete contractor software or bidding software?",
    a: "Concrete Cost Pro covers the estimating and bidding side of running a concrete contracting business, sometimes searched as concrete estimator software, concrete contractor software or concrete bidding software. It doesn't include scheduling, invoicing/accounting integrations or crew management.",
  },
  {
    q: "What if I want a refund?",
    a: "Email us within 14 days of purchase and we'll refund it in full, no questions asked. See the refund policy for the details.",
  },
];

const softwareApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Concrete Cost Pro",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (web browser)",
  url: "https://concretecostpro.com/concrete-estimating-software/",
  offers: {
    "@type": "Offer",
    price: "79",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
  },
  description:
    "Concrete estimating and job-profitability software: quantities, true job costs, target-margin pricing, rate health and estimate-vs-actual reporting for concrete contractors. $79 launch price (regularly $99), no subscription.",
};

function money(n: number): string {
  return `$${n.toLocaleString("en-US")}`;
}
---

<Layout
  title="Concrete Estimating Software | Concrete Cost Pro"
  description="Price concrete jobs from true cost, not guesswork. Save your rates, estimate multi-section projects, solve for your target margin, and compare actual job costs with your estimate. $79 once, no subscription."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareApplicationSchema)} />
  </Fragment>
  <PublicHeader />
  <main>
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Concrete Estimating Software", href: "/concrete-estimating-software" }]} />

    <!-- HERO -->
    <section id="hero" class="border-b border-border bg-white">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16">
        <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[1fr_1.05fr] lg:gap-14">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-orange">Concrete estimating & job-profitability software</p>
            <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-ink sm:text-5xl">
              Know What Every Concrete Job Really Costs Before You Quote It
            </h1>
            <p class="mt-4 max-w-xl text-lg text-muted">
              Build complete estimates using your own material, labor, equipment, overhead and margin numbers, then
              compare the estimate with what the job actually cost.
            </p>
            <p class="mt-5 inline-flex items-center gap-2 text-sm font-semibold">
              <span class="text-muted line-through">$99</span>
              <span class="rounded-full bg-orange/10 px-2.5 py-1 text-orange">$79 Lifetime Launch Price</span>
            </p>
            <p class="mt-1.5 text-sm text-muted">One payment. No monthly subscription.</p>
            <div class="mt-6 flex flex-wrap items-center gap-3">
              <a
                href="/pricing"
                data-pricing-cta
                data-analytics-event="pro_cta_clicked"
                data-analytics-source="estimating_software_hero"
                class="inline-flex items-center justify-center rounded-lg bg-orange px-6 py-3.5 text-base font-semibold text-white transition hover:bg-orange-dark"
              >
                <span data-pricing-cta-label>Get Concrete Cost Pro — $79 Once</span>
              </a>
              <a
                href="#customer-estimate"
                class="inline-flex items-center justify-center rounded-lg border border-border bg-white px-6 py-3.5 text-base font-semibold text-ink transition hover:bg-warm-white"
              >
                View a Real Estimate
              </a>
            </div>
            <p class="mt-3 text-sm text-muted">Instant access · No account required · Your data stays on your device</p>
            <p class="mt-1 text-sm text-muted">Not right for you? Email us within 14 days for a full refund, no questions asked.</p>
          </div>

          <!-- Product mockup: same visual language as the real app (ResultRow/Badge), a labeled
               example, not a raw screenshot -- see heroExample's comment above for the math. -->
          <div class="relative">
            <div class="overflow-hidden rounded-xl border border-border bg-white shadow-2xl">
              <div class="flex items-center gap-1.5 border-b border-border bg-warm-white px-3 py-2.5">
                <span class="h-2.5 w-2.5 rounded-full bg-red/50" aria-hidden="true"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-amber/50" aria-hidden="true"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-green/50" aria-hidden="true"></span>
                <span class="ml-2 text-xs text-muted">Concrete Cost Pro — Example project</span>
              </div>
              <div class="p-5 sm:p-6">
                <div class="flex items-center justify-between">
                  <div>
                    <p class="text-xs font-bold uppercase tracking-wide text-muted">Example project</p>
                    <h2 class="text-lg font-bold text-ink">{heroExample.project}</h2>
                  </div>
                  <span class="inline-flex items-center rounded-full bg-green-light px-2.5 py-1 text-xs font-semibold text-green">On Target</span>
                </div>
                <div class="mt-4 grid grid-cols-2 gap-x-4 divide-y divide-border sm:grid-cols-4 sm:divide-y-0">
                  <div class="py-3.5 sm:py-0">
                    <div class="text-sm text-muted">Order quantity</div>
                    <div class="text-2xl font-bold text-ink">{heroExample.quantityYd3} yd³</div>
                  </div>
                  <div class="py-3.5 sm:py-0">
                    <div class="text-sm text-muted">True job cost</div>
                    <div class="text-2xl font-bold text-ink">{money(heroExample.trueCost)}</div>
                  </div>
                  <div class="py-3.5 sm:py-0">
                    <div class="text-sm text-muted">Target margin</div>
                    <div class="text-2xl font-bold text-ink">{heroExample.targetMarginPercent}%</div>
                  </div>
                  <div class="py-3.5 sm:py-0">
                    <div class="text-sm text-muted">Required selling price</div>
                    <div class="text-3xl font-bold text-green">{money(heroExample.requiredPrice)}</div>
                  </div>
                </div>
                <div class="mt-5 overflow-hidden rounded-lg border border-border">
                  <img
                    src="/guide/09-estimate-summary.png"
                    alt="Branded customer estimate document preview for the Smith Driveway example"
                    loading="eager"
                    class="w-full"
                  />
                </div>
              </div>
            </div>
            <div class="absolute -left-4 -top-4 hidden max-w-[13rem] rounded-lg border border-border bg-white px-3.5 py-2.5 text-xs font-semibold text-ink shadow-lg sm:block">
              Price from target margin, not guesswork
            </div>
            <div class="absolute -bottom-4 -right-4 hidden max-w-[13rem] rounded-lg border border-border bg-white px-3.5 py-2.5 text-xs font-semibold text-ink shadow-lg sm:block">
              See estimated vs. actual profit
            </div>
          </div>
        </div>

        <div class="mt-10 border-t border-border pt-6">
          <TrustBadges
            align="center"
            items={["One-time payment", "No signup required", "No recurring subscription", "Local-first privacy", "Exportable estimates and backups"]}
          />
        </div>
      </div>
    </section>

    <!-- PROBLEM SECTION -->
    <section class="border-b border-border bg-warm-white">
      <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-2xl font-extrabold text-ink sm:text-3xl">A Job Can Look Profitable and Still Lose Money</h2>
          <p class="mt-3 text-muted">
            Material increases, underestimated labor, equipment charges and forgotten overhead can quietly consume
            your margin. Concrete Cost Pro brings those costs together before you commit to a price.
          </p>
        </div>
        <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div class="rounded-xl border border-red/20 bg-white p-5">
            <p class="text-xs font-bold uppercase tracking-wide text-red">Guesswork quote</p>
            <p class="mt-3 text-sm text-muted">Selling price</p>
            <p class="text-2xl font-bold text-ink">{money(guesswork.price)}</p>
            <p class="mt-3 text-sm text-muted">Forgotten overhead</p>
            <p class="text-lg font-semibold text-ink">{money(guesswork.forgottenOverhead)}</p>
            <div class="mt-4 rounded-lg border border-red/20 bg-red-light p-3.5">
              <p class="text-sm font-semibold text-red">Actual margin: {guesswork.actualMarginPercent}%</p>
              <p class="mt-0.5 text-xs text-red">Margin at risk</p>
            </div>
          </div>
          <div class="rounded-xl border-2 border-green/30 bg-white p-5 shadow-md">
            <p class="text-xs font-bold uppercase tracking-wide text-green">True-cost quote</p>
            <p class="mt-3 text-sm text-muted">True cost</p>
            <p class="text-2xl font-bold text-ink">{money(trueCostCard.trueCost)}</p>
            <p class="mt-3 text-sm text-muted">Target margin</p>
            <p class="text-lg font-semibold text-ink">{trueCostCard.targetMarginPercent}%</p>
            <div class="mt-4 rounded-lg border border-green/20 bg-green-light p-3.5">
              <p class="text-sm font-semibold text-green">Required price: {money(trueCostCard.requiredPrice)}</p>
              <p class="mt-0.5 text-xs text-green">On target</p>
            </div>
          </div>
        </div>
        <p class="mx-auto mt-6 max-w-2xl text-center text-xs text-muted">Example figures, not a real customer's numbers.</p>
        <p class="mx-auto mt-6 max-w-2xl rounded-lg border border-border bg-white p-4 text-center text-sm text-muted">
          <strong class="text-ink">Margin vs. markup:</strong> margin is profit as a share of your selling price;
          markup is profit as a share of your cost. A 30% markup on cost is only a 23% margin on price. Concrete
          Cost Pro solves for the price that hits your actual target <em>margin</em>, not a markup that quietly
          falls short of it.
        </p>
      </div>
    </section>

    <!-- WORKFLOW SECTION -->
    <section class="border-b border-border bg-white">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <h2 class="text-center text-2xl font-extrabold text-ink sm:text-3xl">From Dimensions to a Profitable Quote</h2>
        <div class="relative mt-10">
          <div class="absolute left-0 right-0 top-6 hidden h-px bg-border lg:block" aria-hidden="true"></div>
          <div class="grid grid-cols-1 gap-8 lg:grid-cols-4 lg:gap-6">
            {workflowSteps.map((step) => (
              <div class="relative">
                <div class="relative z-10 mx-auto flex h-12 w-12 items-center justify-center rounded-full border-2 border-orange bg-white text-lg font-bold text-orange lg:mx-0">
                  {step.n}
                </div>
                <h3 class="mt-3 text-center font-semibold text-ink lg:text-left">{step.title}</h3>
                <p class="mt-1.5 text-center text-sm text-muted lg:text-left">{step.body}</p>
                <div class="mt-4 overflow-hidden rounded-lg border border-border shadow-sm">
                  <img src={step.img} alt={step.alt} loading="lazy" class="w-full" />
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- KILLER FEATURES -->
    <section class="border-b border-border bg-warm-white">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <h2 class="text-center text-2xl font-extrabold text-ink sm:text-3xl">More Than a Concrete Calculator</h2>

        <!-- Feature 1: Rate Health -->
        <div class="mt-10 grid grid-cols-1 items-center gap-8 lg:grid-cols-2">
          <div>
            <p class="text-xs font-bold uppercase tracking-wide text-orange">Rate Health</p>
            <h3 class="mt-1.5 text-xl font-bold text-ink">Find Unprofitable Rates Before They Cost You</h3>
            <p class="mt-2 text-muted">Test your standard per-square-foot rates against your real costs and target margin.</p>
            <div class="mt-4 overflow-hidden rounded-xl border border-border bg-white">
              <p class="border-b border-border bg-warm-white px-4 py-2 text-xs font-bold uppercase tracking-wide text-muted">
                Example templates, target margin 35%
              </p>
              <ul class="divide-y divide-border">
                {rateHealthRows.map((r) => (
                  <li class="flex items-center justify-between px-4 py-2.5 text-sm">
                    <span class="font-medium text-ink">{r.name}</span>
                    <span class="flex items-center gap-2">
                      <span class={r.status === "healthy" ? "text-green" : "text-red"}>{r.margin}%</span>
                      <span class={`rounded-full px-2 py-0.5 text-xs font-semibold ${r.status === "healthy" ? "bg-green-light text-green" : "bg-red-light text-red"}`}>
                        {r.status === "healthy" ? "Healthy" : "Review pricing"}
                      </span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <div class="overflow-hidden rounded-xl border border-border bg-white shadow-sm">
            <div class="flex items-center gap-1.5 border-b border-border bg-warm-white px-3 py-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-red/50" aria-hidden="true"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-amber/50" aria-hidden="true"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-green/50" aria-hidden="true"></span>
            </div>
            <img src="/guide/10-rate-health.png" alt="Rate Health dashboard showing standard concrete rates flagged below target margin, with required price shown for each" loading="lazy" class="w-full" />
          </div>
        </div>

        <!-- Feature 2: Cost-change scenario -->
        <div class="mt-14 grid grid-cols-1 items-center gap-8 lg:grid-cols-2">
          <div class="order-2 lg:order-1 rounded-xl border border-border bg-white p-5 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-wide text-muted">Example scenario</p>
            <p class="mt-2 text-sm text-ink">
              Ready-mix price: <span class="font-semibold">{money(scenario.from)}</span> → <span class="font-semibold text-orange">{money(scenario.to)}</span> per yd³
            </p>
            <div class="mt-4 grid grid-cols-2 gap-3">
              <div class="rounded-lg border border-border bg-warm-white p-3.5">
                <p class="text-xs font-medium uppercase tracking-wide text-muted">Templates checked</p>
                <p class="mt-1 text-2xl font-bold text-ink">{scenario.templatesChecked}</p>
              </div>
              <div class="rounded-lg border border-red/20 bg-red-light p-3.5">
                <p class="text-xs font-medium uppercase tracking-wide text-red">Now below target</p>
                <p class="mt-1 text-2xl font-bold text-red">{scenario.nowBelowTarget}</p>
              </div>
            </div>
          </div>
          <div class="order-1 lg:order-2">
            <p class="text-xs font-bold uppercase tracking-wide text-orange">Cost-change scenarios</p>
            <h3 class="mt-1.5 text-xl font-bold text-ink">See the Impact of a Cost Increase Instantly</h3>
            <p class="mt-2 text-muted">Change a material, labor or equipment rate once and see which of your saved templates fall below target margin.</p>
          </div>
        </div>

        <!-- Feature 3: Estimate vs actual -->
        <div class="mt-14 grid grid-cols-1 items-center gap-8 lg:grid-cols-2">
          <div>
            <p class="text-xs font-bold uppercase tracking-wide text-orange">Estimate vs. actual</p>
            <h3 class="mt-1.5 text-xl font-bold text-ink">Compare the Estimate With the Actual Job</h3>
