---
import Layout from "../layouts/Layout.astro";
import PublicHeader from "../components/PublicHeader.astro";
import PublicFooter from "../components/PublicFooter.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import TrustBadges from "../components/TrustBadges.astro";
import { CheckCircle2, ArrowRight, Check, X } from "lucide-react";

// Hero + problem-section numbers -- a coded recreation of the real app's estimate panel (same
// ResultRow/Badge styling as ProjectCalculatorIsland.tsx), not a raw screenshot, so it can show
// one deliberately chosen, labeled example project. Verified against src/lib/calc.ts:
// requiredSellingPrice = trueCost / (1 - targetMargin) = 8729 / 0.70 = 12,470.00 exactly.
const heroExample = { project: "Smith Driveway", trueCost: 8729, targetMarginPercent: 30, requiredPrice: 12470 };

// Guesswork card: sellingPrice $10,500 at 18% margin implies trueCost = 10500*(1-0.18) =
// $8,610 -- consistent with overhead/labor overrun eating into an assumed lower cost.
const guesswork = { price: 10500, actualMarginPercent: 18 };
const trueCostCard = { trueCost: 8729, targetMarginPercent: 30, requiredPrice: 12470 };

const workflowSteps = [
  {
    n: 1,
    tab: "Job details",
    title: "Job details",
    body: "Enter known project dimensions and combine slabs, driveways, patios, aprons, sidewalks, footings or custom sections into one job.",
    img: "/guide/06-wizard-dimensions.png",
    w: 1116, h: 580,
    alt: "Wizard step showing project dimensions entry for length, width and thickness",
  },
  {
    n: 2,
    tab: "True cost",
    title: "True cost",
    body: "Apply your saved ready-mix, reinforcement, labor, formwork, equipment, delivery and overhead costs.",
    img: "/guide/07-wizard-costs.png",
    w: 1116, h: 691,
    alt: "Wizard step showing material, labor and equipment cost entry pulled from saved rates",
  },
  {
    n: 3,
    tab: "Target price",
    title: "Target price",
    body: "Choose a target margin and immediately see the selling price required to reach it.",
    img: "/guide/08-wizard-price.png",
    w: 1116, h: 480,
    alt: "Wizard step showing true cost, target margin and required selling price",
  },
  {
    n: 4,
    tab: "Customer estimate",
    title: "Customer estimate",
    body: "Create a clean estimate for your customer while keeping internal costs and margins private.",
    img: "/guide/09-estimate-summary.png",
    w: 1116, h: 603,
    alt: "Branded customer estimate document next to an internal cost, overhead and margin panel",
  },
];

// Rate Health example -- illustrative templates, not a real customer's saved rates. Target
// margin 35%, matching this feature's default. Stamped row verified: true cost $11.20/ft2,
// required = 11.20 / (1 - 0.35) = $17.23/ft2 exactly; current $15.00 implies (15-11.20)/15 =
// 25.3% margin, also exact.
const rateHealthRows = [
  { name: "Basic slab", margin: 38.9, status: "healthy" },
  { name: "Driveway", margin: 36.4, status: "healthy" },
  { name: "Patio", margin: 38.0, status: "healthy" },
  { name: "Stamped", margin: 25.3, status: "review" },
];

// Illustrative cost-change scenario, grounded in the real Rate Health feature
// (src/components/app/tabs/RateHealthTab.tsx), which re-prices every saved template against a
// hypothetical rate change and counts how many fall below target margin. It does not touch
// "open estimates" -- the app keeps exactly one current estimate, never an archive (see
// src/lib/persistence.ts's model comment) -- so that concept isn't real and isn't shown here.
const scenario = { from: 165, to: 185, templatesAffected: 6, nowBelowTarget: 3 };

// Estimated-vs-actual example, continuing the same "Smith Driveway" project as the hero.
// Verified: at the hero's $12,470 selling price, actual cost $9,980 gives a margin of
// (12470-9980)/12470 = 19.97%, which rounds to 20%.
const estVsActual = {
  estimated: { concreteYd3: 16, laborHours: 52, cost: 8729, marginPercent: 30 },
  actual: { concreteYd3: 17.2, laborHours: 61, cost: 9980, marginPercent: 20 },
};

const spreadsheetCons = [
  "Rates copied between files",
  "Formulas can be overwritten",
  "Projects become inconsistent",
  "No guided estimate-versus-actual workflow",
  "Difficult to see which standard rates are slipping",
];
const proWins = [
  "Saved business costs",
  "Reusable project templates",
  "Consistent calculations",
  "Target-margin price solver",
  "Estimate-versus-actual comparison",
  "Rate-health visibility",
  "Built-in export and backup",
];

const comparison = [
  { label: "Cost", free: "Free", pro: "$79 once" },
  { label: "One-off quantity and project costing", free: true, pro: true },
  { label: "Saved materials, labor and equipment", free: false, pro: true },
  { label: "Saved overhead and margin targets", free: false, pro: true },
  { label: "Multi-section projects", free: false, pro: true },
  { label: "Reusable templates", free: false, pro: true },
  { label: "Required-price calculation", free: "One project at a time", pro: "Saved as your default, every job" },
  { label: "Rate-health dashboard", free: false, pro: true },
  { label: "Cost-change scenarios", free: false, pro: true },
  { label: "Branded estimates", free: "Basic estimate", pro: true },
  { label: "Estimated-versus-actual results", free: false, pro: true },
  { label: "CSV export", free: false, pro: true },
  { label: "Workspace backup and restore", free: false, pro: true },
];

const pricingIncludes = [
  "Complete concrete estimating workflow",
  "Saved business costs and templates",
  "Multi-section estimates",
  "Target-margin pricing",
  "Rate-health analysis",
  "Cost-change scenarios",
  "Customer-ready estimates",
  "Estimated-versus-actual tracking",
  "CSV export",
  "Workspace backup and restore",
];

const faqs = [
  {
    q: "Is this a monthly subscription?",
    a: "No. Concrete Cost Pro is currently offered for a one-time $79 launch price.",
  },
  {
    q: "Does it calculate concrete quantity?",
    a: "Yes. Enter your known project dimensions and the application calculates concrete volume and purchase quantity using your selected allowance and rounding settings.",
  },
  {
    q: "Can I use my own material and labor costs?",
    a: "Yes. Save your own ready-mix, reinforcement, formwork, labor, equipment, delivery, overhead and other costs.",
  },
  {
    q: "Can it price for a target margin?",
    a: "Yes. Enter your target margin and Concrete Cost Pro calculates the selling price required based on your estimated true job cost.",
  },
  {
    q: "Can it handle projects with multiple sections?",
    a: "Yes. Combine multiple slabs, driveway sections, patios, aprons, sidewalks, footings or custom rectangular pours in one project.",
  },
  {
    q: "Can I create customer estimates?",
    a: "Yes. Create a customer-ready estimate using your business details, scope, notes and selling price, while keeping internal cost and margin information private.",
  },
  {
    q: "Where is my data stored?",
    a: "Your project data is stored locally in your browser. No account is required. Because local storage is not an automatic backup, regularly export your workspace backup.",
  },
  {
    q: "Does it replace an engineer or determine structural requirements?",
    a: "No. Concrete Cost Pro does not provide engineering, structural-design, load, reinforcement, concrete-strength or building-code recommendations. You supply the project specifications. The software calculates quantities, costs, margins and prices from your inputs.",
  },
];

const softwareApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Concrete Cost Pro",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (web browser)",
  url: "https://concretecostpro.com/concrete-estimating-software/",
  offers: { "@type": "Offer", price: "79", priceCurrency: "USD", availability: "https://schema.org/InStock" },
  description:
    "Concrete estimating and job-profitability software: quantities, true job costs, target-margin pricing, rate health and estimate-vs-actual reporting for concrete contractors. $79 launch price (regularly $99), no subscription.",
};

function money(n: number): string {
  return `$${n.toLocaleString("en-US")}`;
}
---

<Layout
  title="Concrete Estimating Software | Concrete Cost Pro"
  description="Know your true job cost before you quote. Concrete Cost Pro calculates true cost, target-margin pricing and customer-ready estimates from your own rates. $79 once, no subscription."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareApplicationSchema)} />
  </Fragment>
  <PublicHeader />
  <main>
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Concrete Estimating Software", href: "/concrete-estimating-software" }]} />

    <!-- 1. HERO -->
    <section id="hero" class="border-b border-border bg-white">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-14">
        <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-14">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-orange">Concrete estimating & job profitability software</p>
            <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-ink sm:text-5xl">
              Know What Every Concrete Job Really Costs Before You Quote It
            </h1>
            <p class="mt-4 max-w-lg text-lg text-muted">
              Calculate quantities, labor, equipment, overhead and true job cost using your own rates. Then see
              exactly what to charge to hit your target margin.
            </p>
            <p class="mt-5 inline-flex items-center gap-2 text-sm font-semibold">
              <span class="text-muted line-through">$99</span>
              <span class="rounded-full bg-orange/10 px-2.5 py-1 text-orange">$79 Lifetime Launch Price</span>
            </p>
            <p class="mt-1.5 text-sm text-muted">One payment. No monthly subscription.</p>
            <div class="mt-6 flex flex-wrap items-center gap-3">
              <a
                href="/pricing"
                data-pricing-cta
                data-analytics-event="pro_cta_clicked"
                data-analytics-source="estimating_software_hero"
                class="inline-flex items-center justify-center rounded-lg bg-orange px-6 py-3.5 text-base font-semibold text-white transition hover:bg-orange-dark focus-visible:outline-2 focus-visible:outline-offset-2"
              >
                <span data-pricing-cta-label>Get Concrete Cost Pro — $79 Once</span>
              </a>
              <a
                href="#workflow"
                class="inline-flex items-center justify-center rounded-lg border border-border bg-white px-6 py-3.5 text-base font-semibold text-ink transition hover:bg-warm-white"
              >
                See How It Prices a Real Job
              </a>
            </div>
            <p class="mt-3 text-sm text-muted">Instant access · No account required · Your data stays on your device</p>
          </div>

          <!-- Product mockup: same visual language as the real app (ResultRow/Badge), a labeled
               example, not a raw screenshot -- see heroExample's comment above for the math. -->
          <div>
            <div class="overflow-hidden rounded-xl border border-border bg-white shadow-2xl">
              <div class="flex items-center gap-1.5 border-b border-border bg-warm-white px-3 py-2.5">
                <span class="h-2.5 w-2.5 rounded-full bg-red/50" aria-hidden="true"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-amber/50" aria-hidden="true"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-green/50" aria-hidden="true"></span>
                <span class="ml-2 text-xs text-muted">Concrete Cost Pro — Example project</span>
              </div>
              <div class="p-5 sm:p-6">
                <div class="flex items-center justify-between">
                  <div>
                    <p class="text-xs font-bold uppercase tracking-wide text-muted">Example project</p>
                    <h2 class="text-lg font-bold text-ink">{heroExample.project}</h2>
                  </div>
                  <span class="inline-flex items-center rounded-full bg-green-light px-2.5 py-1 text-xs font-semibold text-green">On Target</span>
                </div>
                <div class="mt-5 grid grid-cols-2 gap-4">
                  <div class="rounded-lg border border-border bg-warm-white p-4">
                    <div class="text-xs font-bold uppercase tracking-wide text-muted">True job cost</div>
                    <div class="mt-1 text-3xl font-bold text-ink">{money(heroExample.trueCost)}</div>
                  </div>
                  <div class="rounded-lg border border-green/25 bg-green-light p-4">
                    <div class="text-xs font-bold uppercase tracking-wide text-green">Price for {heroExample.targetMarginPercent}% margin</div>
                    <div class="mt-1 text-3xl font-bold text-green">{money(heroExample.requiredPrice)}</div>
                  </div>
                </div>
                <div class="mt-5 overflow-hidden rounded-lg border border-border">
                  <img
                    src="/guide/09-estimate-summary.png"
                    alt="Branded customer estimate document preview for the Smith Driveway example"
                    loading="eager"
                    width="1116"
                    height="603"
                    class="w-full"
                  />
                </div>
              </div>
            </div>
            <p class="mt-2 text-center text-xs text-muted">Example shown using contractor-entered costs and project specifications.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. TRUST STRIP -->
    <section class="border-b border-border bg-warm-white">
      <div class="mx-auto max-w-6xl px-4 py-5 sm:px-6">
        <TrustBadges
          align="center"
          items={["$79 one-time payment", "No monthly fee", "No account required", "Uses your own business costs", "Local-first data storage"]}
        />
      </div>
    </section>

    <!-- 3. PROBLEM AND OUTCOME -->
    <section class="border-b border-border bg-white">
      <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-2xl font-extrabold text-ink sm:text-3xl">A Job Can Look Profitable Until the Real Costs Show Up</h2>
          <p class="mt-3 text-muted">
            Ready mix is only part of the job. Labor, forms, reinforcement, equipment, delivery, waste and overhead
            all affect what you can safely quote.
          </p>
        </div>
        <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div class="rounded-xl border border-red/20 bg-red-light/40 p-5">
            <p class="text-xs font-bold uppercase tracking-wide text-red">Guesswork quote</p>
            <p class="mt-3 text-sm text-muted">Quoted price</p>
            <p class="text-2xl font-bold text-ink">{money(guesswork.price)}</p>
            <p class="mt-3 text-sm text-muted">Costs missed</p>
            <p class="text-base font-semibold text-ink">Overhead and labor overrun</p>
            <div class="mt-4 rounded-lg border border-red/20 bg-red-light p-3.5">
              <p class="text-sm font-semibold text-red">Actual margin: {guesswork.actualMarginPercent}%</p>
              <p class="mt-0.5 text-xs font-bold uppercase tracking-wide text-red">Margin at risk</p>
            </div>
          </div>
          <div class="rounded-xl border-2 border-green/30 bg-white p-5 shadow-md">
            <p class="text-xs font-bold uppercase tracking-wide text-green">True-cost quote</p>
            <p class="mt-3 text-sm text-muted">True job cost</p>
            <p class="text-2xl font-bold text-ink">{money(trueCostCard.trueCost)}</p>
            <p class="mt-3 text-sm text-muted">Target margin</p>
            <p class="text-base font-semibold text-ink">{trueCostCard.targetMarginPercent}%</p>
            <div class="mt-4 rounded-lg border border-green/20 bg-green-light p-3.5">
              <p class="text-sm font-semibold text-green">Required selling price: {money(trueCostCard.requiredPrice)}</p>
              <p class="mt-0.5 text-xs font-bold uppercase tracking-wide text-green">Priced on target</p>
            </div>
          </div>
        </div>
        <p class="mx-auto mt-6 max-w-2xl text-center text-xs text-muted">Example figures, not a real customer's numbers.</p>
        <p class="mx-auto mt-4 max-w-2xl text-center text-sm text-muted">
          Concrete Cost Pro does not choose your specifications or invent market prices. It calculates from the
          dimensions, costs, overhead and margin targets you provide.
        </p>
        <div class="mt-6 text-center">
          <a
            href="/pricing"
            data-pricing-cta
            data-analytics-event="pro_cta_clicked"
            data-analytics-source="estimating_software_problem"
            class="inline-flex items-center gap-2 rounded-lg bg-orange px-6 py-3.5 text-base font-semibold text-white transition hover:bg-orange-dark"
          >
            <span data-pricing-cta-label>Price a Job From True Cost</span>
            <ArrowRight size={18} aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>

    <!-- 4. INTERACTIVE PRODUCT WORKFLOW -->
    <section id="workflow" class="scroll-mt-20 border-b border-border bg-warm-white">
      <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-2xl font-extrabold text-ink sm:text-3xl">From Job Dimensions to a Profitable Quote</h2>
          <p class="mt-3 text-muted">Build the estimate once, see where every dollar goes, and turn it into a professional customer quote.</p>
        </div>

        <div class="mt-8" data-workflow-tour>
          <div role="tablist" aria-label="Workflow steps" class="flex flex-wrap justify-center gap-2">
            {workflowSteps.map((step) => (
              <button
                type="button"
                role="tab"
                data-step-button={step.n}
                aria-selected={step.n === 1 ? "true" : "false"}
                class="workflow-step-btn rounded-full border border-border bg-white px-4 py-2 text-sm font-semibold text-ink transition aria-selected:border-orange aria-selected:bg-orange aria-selected:text-white"
              >
                {step.n}. {step.tab}
              </button>
            ))}
          </div>

          <div class="mt-6 grid grid-cols-1 items-center gap-8 lg:grid-cols-2">
            <div>
              {workflowSteps.map((step) => (
                <div data-step-panel={step.n} class="workflow-step-panel" hidden={step.n !== 1}>
                  <p class="text-xs font-bold uppercase tracking-wide text-orange">Step {step.n} of {workflowSteps.length}</p>
                  <h3 class="mt-1.5 text-xl font-bold text-ink">{step.title}</h3>
                  <p class="mt-2 text-muted">{step.body}</p>
                </div>
              ))}
            </div>
            <div class="overflow-hidden rounded-xl border border-border bg-white shadow-md">
              <div class="flex items-center gap-1.5 border-b border-border bg-warm-white px-3 py-2.5">
                <span class="h-2.5 w-2.5 rounded-full bg-red/50" aria-hidden="true"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-amber/50" aria-hidden="true"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-green/50" aria-hidden="true"></span>
              </div>
              {workflowSteps.map((step) => (
                <img
                  data-step-image={step.n}
                  src={step.img}
                  alt={step.alt}
                  loading={step.n === 1 ? "eager" : "lazy"}
                  width={step.w}
                  height={step.h}
                  class="w-full"
                  hidden={step.n !== 1}
                />
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. THREE STRONGEST DIFFERENTIATORS -->
    <section class="border-b border-border bg-white">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <h2 class="text-center text-2xl font-extrabold text-ink sm:text-3xl">Not Just Another Concrete Calculator</h2>

        <!-- Feature 1: Rate Health -->
        <div class="mt-10 grid grid-cols-1 items-center gap-8 lg:grid-cols-2">
          <div>
            <p class="text-xs font-bold uppercase tracking-wide text-orange">Rate Health</p>
            <h3 class="mt-1.5 text-xl font-bold text-ink">Know Which Standard Rates Need Attention</h3>
            <p class="mt-2 text-muted">Compare your usual per-square-foot prices with your current costs and target margin. See which services remain healthy and which may need repricing.</p>
          </div>
          <div class="overflow-hidden rounded-xl border border-border bg-white">
            <p class="border-b border-border bg-warm-white px-4 py-2 text-xs font-bold uppercase tracking-wide text-muted">
              Example templates, target margin 35%
            </p>
            <ul class="divide-y divide-border">
              {rateHealthRows.map((r) => (
                <li class="flex items-center justify-between px-4 py-2.5 text-sm">
                  <span class="font-medium text-ink">{r.name}</span>
                  <span class="flex items-center gap-2">
                    <span class={r.status === "healthy" ? "text-green" : "text-red"}>{r.margin}%</span>
                    <span class={`rounded-full px-2 py-0.5 text-xs font-semibold ${r.status === "healthy" ? "bg-green-light text-green" : "bg-red-light text-red"}`}>
                      {r.status === "healthy" ? "Healthy" : "Review pricing"}
                    </span>
                  </span>
                </li>
              ))}
            </ul>
            <p class="border-t border-border bg-orange/5 px-4 py-3 text-sm font-semibold text-ink">
              Required stamped-concrete rate for a 35% margin: <span class="text-orange">$17.23/ft²</span>
            </p>
          </div>
        </div>

        <!-- Feature 2: Cost-change scenario -->
        <div class="mt-14 grid grid-cols-1 items-center gap-8 lg:grid-cols-2">
          <div class="order-2 lg:order-1 rounded-xl border border-border bg-warm-white p-5">
            <p class="text-xs font-bold uppercase tracking-wide text-muted">Example scenario</p>
            <p class="mt-2 text-sm text-ink">
              Ready-mix cost: <span class="font-semibold">{money(scenario.from)}</span> → <span class="font-semibold text-orange">{money(scenario.to)}</span> per yd³
            </p>
            <div class="mt-4 grid grid-cols-2 gap-3">
              <div class="rounded-lg border border-border bg-white p-3.5">
                <p class="text-xs font-medium uppercase tracking-wide text-muted">Templates affected</p>
                <p class="mt-1 text-2xl font-bold text-ink">{scenario.templatesAffected}</p>
              </div>
              <div class="rounded-lg border border-red/20 bg-red-light p-3.5">
                <p class="text-xs font-medium uppercase tracking-wide text-red">Now below target</p>
                <p class="mt-1 text-2xl font-bold text-red">{scenario.nowBelowTarget}</p>
              </div>
            </div>
          </div>
          <div class="order-1 lg:order-2">
            <p class="text-xs font-bold uppercase tracking-wide text-orange">Cost-change scenarios</p>
            <h3 class="mt-1.5 text-xl font-bold text-ink">See What a Cost Increase Changes</h3>
            <p class="mt-2 text-muted">Update a material, labor or equipment rate once. Concrete Cost Pro shows which of your saved templates are affected, and which fall below your target margin.</p>
          </div>
        </div>

        <!-- Feature 3: Estimate vs actual -->
        <div class="mt-14 grid grid-cols-1 items-center gap-8 lg:grid-cols-2">
          <div>
            <p class="text-xs font-bold uppercase tracking-wide text-orange">Estimate vs. actual</p>
            <h3 class="mt-1.5 text-xl font-bold text-ink">Learn From What the Job Actually Cost</h3>
            <p class="mt-2 text-muted">Compare the estimate with actual concrete, labor and job costs. Identify recurring overruns before they become your new normal.</p>
            <div class="mt-4 grid grid-cols-2 gap-3 rounded-xl border border-border bg-warm-white p-4 text-sm">
              <div>
                <p class="text-xs font-bold uppercase tracking-wide text-muted">Estimated</p>
                <p class="mt-1.5 text-ink">Concrete: {estVsActual.estimated.concreteYd3} yd³</p>
                <p class="text-ink">Labor: {estVsActual.estimated.laborHours} hours</p>
                <p class="text-ink">Cost: {money(estVsActual.estimated.cost)}</p>
                <p class="font-semibold text-green">Margin: {estVsActual.estimated.marginPercent}%</p>
              </div>
              <div class="border-l border-border pl-3">
                <p class="text-xs font-bold uppercase tracking-wide text-muted">Actual</p>
                <p class="mt-1.5 text-ink">Concrete: {estVsActual.actual.concreteYd3} yd³</p>
                <p class="text-ink">Labor: {estVsActual.actual.laborHours} hours</p>
                <p class="text-ink">Cost: {money(estVsActual.actual.cost)}</p>
                <p class="font-semibold text-red">Margin: {estVsActual.actual.marginPercent}%</p>
              </div>
            </div>
            <p class="mt-3 text-sm font-medium text-ink">Better records today create better estimates tomorrow.</p>
          </div>
          <div class="overflow-hidden rounded-xl border border-border bg-white shadow-sm">
            <div class="flex items-center gap-1.5 border-b border-border bg-warm-white px-3 py-2.5">
