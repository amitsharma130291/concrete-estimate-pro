---
import Layout from "../layouts/Layout.astro";
import PublicHeader from "../components/PublicHeader.astro";
import PublicFooter from "../components/PublicFooter.astro";
import FaqAccordion from "../components/FaqAccordion.astro";

const workflow = [
  "Project", "Dimensions", "Concrete quantity", "Purchase allowance", "Materials",
  "Labor", "Equipment, forms & reinforcement", "True cost", "Target margin", "Estimate", "Actual job",
];

const featureGroups = [
  {
    title: "Estimate every job accurately",
    items: [
      "Save your ready-mix, material, labor and equipment rates once",
      "Multi-section projects for L-shaped driveways and complex pours",
      "Reusable project templates for your standard jobs",
    ],
  },
  {
    title: "Know your real numbers",
    items: [
      "Overhead and target-margin pricing built in",
      "Rate Health audit flags underpriced standard rates",
      "Required-price solver for any cost or margin change",
    ],
  },
  {
    title: "Win the job and track it",
    items: [
      "Branded, customer-ready estimate PDFs",
      "Estimate vs. actual comparison after every job",
      "Historical quantity, labor and margin variance",
    ],
  },
];

const faqs = [
  {
    q: "Is this concrete takeoff software?",
    a: "No — Concrete Estimate Pro is manual quantity and cost estimating software for project dimensions you already know. It does not read blueprints or PDF plans automatically.",
  },
  {
    q: "Does it determine engineering specifications?",
    a: "No. Slab thickness, footing size, reinforcement, concrete strength, load capacity and code compliance are never generated by this software — you supply those specifications and the app calculates quantity, cost and pricing from them.",
  },
  {
    q: "Do I need internet access to use it?",
    a: "No. It's local-first — your data lives in your browser, and estimating works without a live connection once the app is loaded.",
  },
  {
    q: "Is there a monthly fee?",
    a: "No. Concrete Estimate Pro is a single $99 lifetime purchase with no subscription.",
  },
];
---

<Layout
  title="Concrete Estimating Software | Concrete Estimate Pro"
  description="Concrete estimating software without another monthly subscription. Calculate quantities, true job costs, target-margin pricing, and estimate-vs-actual profitability. $99 lifetime."
>
  <PublicHeader />
  <main>
    <section class="border-b border-border bg-white">
      <div class="mx-auto max-w-4xl px-4 py-14 text-center sm:px-6">
        <h1 class="text-3xl font-extrabold tracking-tight text-ink sm:text-5xl">
          Concrete Estimating Software Without Another Monthly Subscription
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-muted">
          Calculate quantities, true job costs, target-margin pricing, and estimate-vs-actual profitability — all in
          one local-first tool built for concrete contractors.
        </p>
        <a
          href="/pricing"
          class="mt-6 inline-flex items-center justify-center rounded-lg bg-orange px-6 py-3.5 text-base font-semibold text-white transition hover:bg-orange-dark"
        >
          Get Concrete Estimate Pro — $99 Lifetime
        </a>
      </div>
    </section>

    <section class="border-b border-border bg-white">
      <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
        <h2 class="text-center text-xl font-semibold text-ink">One workflow, start to finish</h2>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
          {workflow.map((step, i) => (
            <>
              <span class="rounded-full border border-border bg-warm-white px-3 py-1.5 text-xs font-medium text-ink">{step}</span>
              {i < workflow.length - 1 && <span class="text-muted" aria-hidden="true">&rarr;</span>}
            </>
          ))}
        </div>
      </div>
    </section>

    <section id="features" class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
        {featureGroups.map((group) => (
          <div>
            <h3 class="font-semibold text-ink">{group.title}</h3>
            <ul class="mt-3 space-y-2.5">
              {group.items.map((item) => (
                <li class="flex items-start gap-2 text-sm text-muted">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mt-0.5 shrink-0 text-orange" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="border-y border-border bg-white">
      <div class="mx-auto max-w-3xl px-4 py-12 text-center sm:px-6">
        <h2 class="text-2xl font-bold text-ink">The application never guesses your structural specs</h2>
        <p class="mt-3 text-muted">
          Slab thickness, footing dimensions, reinforcement, concrete strength, load capacity, foundation design and
          building-code compliance always come from you, your engineer, or local code — never from this software.
          Concrete Estimate Pro only calculates quantity, cost, labor, overhead, margin and price from the
          specifications you provide.
        </p>
      </div>
    </section>

    <section id="faq" class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
      <FaqAccordion faqs={faqs} />
    </section>

    <section class="bg-charcoal">
      <div class="mx-auto max-w-4xl px-4 py-14 text-center sm:px-6">
        <h2 class="text-2xl font-bold text-white sm:text-3xl">$99 Lifetime</h2>
        <p class="mx-auto mt-3 max-w-xl text-white/70">One payment. Every future update. No subscription.</p>
        <a
          href="/pricing"
          class="mt-6 inline-flex items-center justify-center rounded-lg bg-orange px-6 py-3.5 text-base font-semibold text-white transition hover:bg-orange-dark"
        >
          Get Concrete Estimate Pro
        </a>
      </div>
    </section>
  </main>
  <PublicFooter />
</Layout>
