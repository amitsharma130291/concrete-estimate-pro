---
import Layout from "../layouts/Layout.astro";
import PublicHeader from "../components/PublicHeader.astro";
import PublicFooter from "../components/PublicFooter.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactForm from "../components/ContactForm";
---

<Layout
  title="Contact Us | Concrete Cost Pro"
  description="Questions about Concrete Cost Pro, a calculator, or an existing purchase? Send us a message."
>
  <PublicHeader />
  <main>
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Contact", href: "/contact" }]} />
    <section class="border-b border-border bg-white">
      <div class="mx-auto max-w-3xl px-4 py-12 text-center sm:px-6">
        <h1 class="text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">Contact Us</h1>
        <p class="mx-auto mt-3 max-w-xl text-lg text-muted">
          Questions about Concrete Cost Pro, a calculator, or an existing purchase? Send us a message and we'll get
          back to you.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-2xl px-4 py-12 sm:px-6">
      <ContactForm client:load />
    </section>
  </main>
  <PublicFooter />
</Layout>
