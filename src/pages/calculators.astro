        >
          <span data-pricing-cta-label>See Pro</span>
        </a>
        <button type="button" id="sticky-bar-dismiss" aria-label="Dismiss" class="rounded-lg p-2 text-muted transition hover:bg-warm-white hover:text-ink">
          <X size={18} aria-hidden="true" />
        </button>
      </div>
    </div>
