  <script define:vars={{ finderRouting, finderNames }}>
    // Guided calculator finder: two button groups pick a live recommendation + link.
    const finder = document.querySelector("[data-finder]");
    if (finder) {
      const calcButtons = finder.querySelectorAll("[data-finder-calc]");
      const projectButtons = finder.querySelectorAll("[data-finder-project]");
      const resultEl = finder.querySelector("[data-finder-result]");
      const linkEl = finder.querySelector("[data-finder-link]");

      function currentSelection() {
        const calc = finder.querySelector('[data-finder-calc][aria-pressed="true"]')?.dataset.finderCalc;
        const project = finder.querySelector('[data-finder-project][aria-pressed="true"]')?.dataset.finderProject;
        return { calc, project };
      }

      function updateRecommendation() {
        const { calc, project } = currentSelection();
        const href = finderRouting[calc]?.[project];
        if (!href) return;
        const slug = href.replace(/^\//, "").replace(/\/$/, "");
        resultEl.textContent = finderNames[slug] || finderNames[href.replace(/^\//, "")] || href;
        linkEl.href = href;
        linkEl.dataset.analyticsCalc = calc;
        linkEl.dataset.analyticsProject = project;
      }

      calcButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          calcButtons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
          updateRecommendation();
        });
      });
      projectButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          projectButtons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
          updateRecommendation();
        });
      });
      updateRecommendation();
    }

    // Search + filter for the "All calculators" directory.
    const searchInput = document.getElementById("tool-search");
    const chips = document.querySelectorAll("[data-filter-chip]");
    const cards = document.querySelectorAll("[data-tool-card]");
    const noResults = document.getElementById("no-results");

    function applyFilter() {
      const query = (searchInput?.value || "").trim().toLowerCase();
      const activeChip = document.querySelector('[data-filter-chip][aria-pressed="true"]')?.dataset.filterChip || "all";
      let visibleCount = 0;
      cards.forEach((card) => {
        const name = card.dataset.toolName || "";
        const tags = (card.dataset.toolTags || "").split(" ");
        const matchesQuery = !query || name.includes(query);
        const matchesChip = activeChip === "all" || tags.includes(activeChip);
        const visible = matchesQuery && matchesChip;
        card.hidden = !visible;
        if (visible) visibleCount++;
      });
      document.querySelectorAll("[data-tool-category]").forEach((category) => {
        const anyVisible = [...category.querySelectorAll("[data-tool-card]")].some((c) => !c.hidden);
        category.hidden = !anyVisible;
      });
      noResults.hidden = visibleCount !== 0;
    }
    searchInput?.addEventListener("input", applyFilter);
    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
        applyFilter();
      });
    });

    // Compact interactive Pro preview: one visible panel at a time.
    const tour = document.querySelector("[data-pro-tour]");
    if (tour) {
      const tourButtons = tour.querySelectorAll("[data-tour-button]");
      tourButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const step = btn.dataset.tourButton;
          tourButtons.forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
          tour.querySelectorAll("[data-tour-panel]").forEach((panel) => {
            panel.hidden = panel.dataset.tourPanel !== step;
          });
        });
      });
    }

    // Dismissible sticky bar: shown only after scrolling past the calculator directory, and
    // only if the visitor hasn't already dismissed it this session.
    const directoryEnd = document.getElementById("all-calculators");
    const bar = document.getElementById("sticky-purchase-bar");
    const dismissBtn = document.getElementById("sticky-bar-dismiss");
    const DISMISS_KEY = "ccp.calculatorsStickyDismissed";
    let dismissed = false;
    try {
      dismissed = sessionStorage.getItem(DISMISS_KEY) === "1";
    } catch {}

    if (directoryEnd && bar && !dismissed) {
      // isIntersecting alone can't distinguish "not scrolled there yet" (false, the section is
      // still below the viewport) from "scrolled past it" (also false, the section is now
      // above the viewport) -- both read as not-intersecting. boundingClientRect.bottom
      // disambiguates: only negative once the section's own bottom edge has scrolled above the
      // viewport top, i.e. the whole directory (not just its top) has been passed.
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!dismissed) bar.hidden = entry.boundingClientRect.bottom >= 0;
        },
        { threshold: [0, 1] },
      );
      observer.observe(directoryEnd);
    }
    dismissBtn?.addEventListener("click", () => {
      dismissed = true;
      bar.hidden = true;
      try {
        sessionStorage.setItem(DISMISS_KEY, "1");
      } catch {}
    });
  </script>
