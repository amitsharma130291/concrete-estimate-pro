---
import Layout from "../layouts/Layout.astro";
import PublicHeader from "../components/PublicHeader.astro";
import PublicFooter from "../components/PublicFooter.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import TrustBadges from "../components/TrustBadges.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { CALCULATOR_CONFIGS } from "../data/calculatorConfigs";
import { Calculator, Car, Square, Sun, Layers, Footprints, Receipt, FileText, ArrowRight, Check, X, Search } from "lucide-react";

const ICONS: Record<string, any> = {
  general: Calculator,
  driveway: Car,
  slab: Square,
  patio: Sun,
  footing: Layers,
  sidewalk: Footprints,
};

// Every tool on the page, tagged for the search/filter controls below. Quantity and cost tags
// both apply to every project calculator -- each one calculates both in a single tool, there's
// no separate "quantity only" page to point a "Quantity" filter at.
const projectTools = Object.values(CALCULATOR_CONFIGS)
  .sort((a, b) => (a.projectType === "general" ? -1 : b.projectType === "general" ? 1 : 0))
  .map((c) => ({
    title: c.h1,
    outcome: c.intro.split(".")[0] + ".",
    bestFor:
      c.projectType === "general"
        ? "Custom or mixed project types"
        : c.projectType === "footing"
          ? "Continuous and isolated footings"
          : `${c.h1.replace("Concrete ", "").replace(" Cost Calculator", "")} pours`,
    href: `/${c.slug}`,
    icon: ICONS[c.projectType],
    tags: ["quantity", "cost"],
    category: "project",
  }));

const businessTools = [
  {
    title: "Concrete Job Cost Calculator",
    outcome: "Enter your own costs directly to see true job cost, current margin and the price required to hit your target.",
    bestFor: "Contractors who already know their costs and want the selling price",
    href: "/concrete-job-cost-calculator",
    icon: Receipt,
    tags: ["pricing"],
    category: "business",
  },
];

const estimateTools = [
  {
    title: "Concrete Estimate Template",
    outcome: "An interactive estimate and quote template. Fill it in and print a customer-ready document in minutes.",
    bestFor: "Anyone who needs a clean, printable estimate right now",
    href: "/concrete-estimate-template",
    icon: FileText,
    tags: ["estimate"],
    category: "estimate",
  },
];

const allTools = [...projectTools, ...businessTools, ...estimateTools];

const filterChips = [
  { key: "all", label: "All" },
  { key: "quantity", label: "Quantity" },
  { key: "cost", label: "Cost" },
  { key: "pricing", label: "Contractor Pricing" },
  { key: "estimate", label: "Estimate Templates" },
];

const bridgeFree = [
  "Enter rates for the current calculation",
  "Calculate one project at a time",
  "Get quantity and cost results",
  "Manually repeat the process on the next job",
];
const bridgePro = [
  "Save material, labor, equipment and overhead rates",
  "Reuse project templates",
  "Combine multiple project sections",
  "Calculate a target-margin selling price",
  "Produce customer-ready estimates",
  "Compare estimated and actual job performance",
];

const darkCtaBenefits = [
  "Saved material, labor and equipment costs",
  "Multi-section projects",
  "Target-margin price calculation",
  "Customer-ready estimates",
  "Estimate-versus-actual tracking",
];

const faqs = [
  {
    q: "Are the concrete calculators free?",
    a: "Yes. The calculators are free to use and do not require an account or purchase.",
  },
  {
    q: "Do the calculators provide local concrete prices?",
    a: "No. Enter the material, labor and equipment prices that apply to your project and location.",
  },
  {
    q: "What is the difference between project cost and selling price?",
    a: "Project cost is what the job is estimated to cost the business. Selling price includes the amount required to cover those costs and reach the selected target margin.",
  },
  {
    q: "Can I save my rates?",
    a: "The free calculators are designed for individual calculations. Concrete Cost Pro lets you save business costs and reuse them across projects.",
  },
  {
    q: "Can I combine multiple project sections?",
    a: "Concrete Cost Pro supports complete projects containing multiple sections. Individual free-calculator capabilities depend on the selected tool.",
  },
  {
    q: "Do these calculators determine slab thickness or reinforcement?",
    a: "No. The tools do not provide structural engineering or building-code recommendations. Enter dimensions and specifications appropriate for your project and supplied by the responsible contractor, designer, engineer or authority.",
  },
  {
    q: "Where is my data stored?",
    a: "Calculator inputs and Concrete Cost Pro data are stored locally in your browser, where supported, not on a server or account. Local storage is not an automatic backup: Concrete Cost Pro users should export a workspace backup regularly.",
  },
];

const site = Astro.site ?? new URL("https://concretecostpro.com");
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: allTools.map((t, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: t.title,
    url: new URL(t.href, site).toString(),
  })),
};

// Guided-finder routing: quantity/cost depend on project type (every project calculator
// computes both together); contractor price and customer estimate always route to the same
// tool regardless of project type, since neither of those is a per-shape page.
const projectSlugs: Record<string, string> = Object.fromEntries(
  Object.values(CALCULATOR_CONFIGS).map((c) => [c.projectType, `/${c.slug}`]),
);
const finderRouting = {
  quantity: projectSlugs,
  cost: projectSlugs,
  price: { slab: "/concrete-job-cost-calculator", driveway: "/concrete-job-cost-calculator", patio: "/concrete-job-cost-calculator", footing: "/concrete-job-cost-calculator", sidewalk: "/concrete-job-cost-calculator", general: "/concrete-job-cost-calculator" },
  estimate: { slab: "/concrete-estimate-template", driveway: "/concrete-estimate-template", patio: "/concrete-estimate-template", footing: "/concrete-estimate-template", sidewalk: "/concrete-estimate-template", general: "/concrete-estimate-template" },
};
const finderNames: Record<string, string> = Object.fromEntries(
  [...Object.values(CALCULATOR_CONFIGS).map((c) => [c.slug, c.h1] as const), ["concrete-job-cost-calculator", "Concrete Job Cost Calculator"], ["concrete-estimate-template", "Concrete Estimate Template"]],
);
---

<Layout
  title="Free Concrete Calculators | Concrete Cost Pro"
  description="Every free concrete calculator in one place: cost, quantity and job-cost calculators for driveways, slabs, patios, footings and sidewalks, plus an interactive estimate template."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListSchema)} />
  </Fragment>
  <PublicHeader />
  <main>
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Calculators", href: "/calculators" }]} />

    <!-- 2. HERO -->
    <section id="hero" class="border-b border-border bg-white">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-14">
        <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-14">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-orange">Free concrete cost & quantity tools</p>
            <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-ink sm:text-5xl">Find the Right Concrete Calculator for Your Project</h1>
            <p class="mt-4 max-w-lg text-lg text-muted">
              Calculate concrete quantity, material cost, labor, total job cost or contractor pricing. Choose a
              project below and get an instant result using your own dimensions and rates.
            </p>
            <div class="mt-6 flex flex-wrap items-center gap-3">
              <a href="#finder" class="inline-flex items-center justify-center rounded-lg bg-orange px-6 py-3.5 text-base font-semibold text-white transition hover:bg-orange-dark">
                Choose a Calculator
              </a>
            </div>
            <p class="mt-3 text-sm">
              <a href="/concrete-estimating-software" class="font-medium text-orange hover:underline">Pricing a complete job? See Concrete Cost Pro &rarr;</a>
            </p>
            <div class="mt-6">
              <TrustBadges items={["Free to use", "No signup", "No purchase required", "Data stays on your device"]} align="left" />
            </div>
          </div>

          <!-- Guided calculator finder -->
          <div id="finder" class="scroll-mt-20 rounded-2xl border border-border bg-warm-white p-5 sm:p-6" data-finder>
            <p class="text-xs font-bold uppercase tracking-wide text-muted">What are you calculating?</p>
            <div role="group" aria-label="What are you calculating?" class="mt-2.5 flex flex-wrap gap-2">
              {[
                { key: "quantity", label: "Concrete quantity" },
                { key: "cost", label: "Project cost" },
                { key: "price", label: "Contractor selling price" },
                { key: "estimate", label: "Customer estimate" },
              ].map((opt, i) => (
                <button
                  type="button"
                  data-finder-calc={opt.key}
                  aria-pressed={i === 0 ? "true" : "false"}
                  class="finder-btn rounded-full border border-border bg-white px-3.5 py-2 text-sm font-medium text-ink transition aria-pressed:border-orange aria-pressed:bg-orange aria-pressed:text-white"
                >
                  {opt.label}
                </button>
              ))}
            </div>

            <p class="mt-5 text-xs font-bold uppercase tracking-wide text-muted">What type of project?</p>
            <div role="group" aria-label="What type of project?" class="mt-2.5 flex flex-wrap gap-2">
              {[
                { key: "slab", label: "Slab" },
                { key: "driveway", label: "Driveway" },
                { key: "patio", label: "Patio" },
                { key: "footing", label: "Footing" },
                { key: "sidewalk", label: "Sidewalk" },
                { key: "general", label: "Custom" },
              ].map((opt, i) => (
                <button
                  type="button"
                  data-finder-project={opt.key}
                  aria-pressed={i === 1 ? "true" : "false"}
                  class="finder-btn rounded-full border border-border bg-white px-3.5 py-2 text-sm font-medium text-ink transition aria-pressed:border-orange aria-pressed:bg-orange aria-pressed:text-white"
                >
                  {opt.label}
                </button>
              ))}
            </div>

            <div class="mt-6 rounded-xl border border-orange/25 bg-white p-4">
              <p class="text-xs font-bold uppercase tracking-wide text-muted">Recommended tool</p>
              <p data-finder-result class="mt-1 text-lg font-bold text-ink">Concrete Driveway Cost Calculator</p>
              <a
                data-finder-link
                href="/concrete-driveway-cost-calculator"
                data-analytics-event="calculator_finder_used"
                class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-orange px-5 py-3 text-sm font-semibold text-white transition hover:bg-orange-dark"
              >
                Open This Calculator
                <ArrowRight size={16} aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. QUICK INTENT SELECTOR -->
    <section class="border-b border-border bg-warm-white">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <h2 class="text-center text-2xl font-extrabold text-ink sm:text-3xl">What Do You Need to Calculate?</h2>
        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {[
            { tag: "Quantity", q: "How much concrete should I order?", cta: "Calculate Concrete Quantity", href: "/concrete-cost-calculator" },
            { tag: "Project cost", q: "What will this slab, driveway or patio cost?", cta: "Calculate Project Cost", href: "/concrete-cost-calculator" },
            { tag: "Contractor price", q: "What should I charge to reach my target margin?", cta: "Calculate Selling Price", href: "/concrete-job-cost-calculator" },
            { tag: "Customer estimate", q: "How can I create a printable concrete estimate?", cta: "Create an Estimate", href: "/concrete-estimate-template" },
          ].map((card) => (
            <a
              href={card.href}
              data-analytics-event="calculator_card_clicked"
              data-analytics-source={`intent_${card.tag.toLowerCase().replace(/\s+/g, "_")}`}
              class="group flex min-h-[44px] flex-col rounded-xl border border-border bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-orange hover:shadow-md"
            >
              <p class="text-xs font-bold uppercase tracking-wide text-orange">{card.tag}</p>
              <p class="mt-2 flex-1 font-semibold text-ink">{card.q}</p>
              <span class="mt-3.5 inline-flex items-center gap-1 text-sm font-medium text-orange">
                {card.cta}
                <ArrowRight size={14} strokeWidth={2.5} aria-hidden="true" className="transition group-hover:translate-x-0.5" />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. FEATURED CALCULATORS -->
    <section class="border-b border-border bg-white">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <h2 class="text-center text-2xl font-extrabold text-ink sm:text-3xl">Most Popular Concrete Calculators</h2>
        <p class="mx-auto mt-2 max-w-lg text-center text-muted">Start with one of the most common project types.</p>
        <div class="mt-8 grid grid-cols-1 gap-5 lg:grid-cols-3">
          {[
            {
              title: "Concrete Slab Cost Calculator",
              desc: "Estimate concrete quantity, ready-mix cost, labor, reinforcement, formwork, equipment and total slab cost.",
              bestFor: "Garage slabs, shop floors, pads and other rectangular slabs",
              cta: "Calculate Slab Cost",
              href: "/concrete-slab-cost-calculator",
              shape: "slab",
            },
            {
              title: "Concrete Driveway Cost Calculator",
              desc: "Calculate concrete quantity and project cost for a driveway using your own dimensions, material prices and labor costs.",
              bestFor: "Driveways, extensions, aprons and replacement projects",
              cta: "Calculate Driveway Cost",
              href: "/concrete-driveway-cost-calculator",
              shape: "driveway",
            },
            {
              title: "Concrete Cost Calculator",
              desc: "Build a quick cost estimate for a slab, driveway, patio, sidewalk, footing or custom rectangular pour.",
              bestFor: "Comparing quantity, cost and contractor-pricing scenarios",
              cta: "Open General Calculator",
              href: "/concrete-cost-calculator",
              shape: "general",
            },
          ].map((card) => (
            <a
              href={card.href}
              data-analytics-event="calculator_card_clicked"
              data-analytics-source={`featured_${card.shape}`}
              class="group flex flex-col overflow-hidden rounded-xl border border-border bg-warm-white shadow-sm transition hover:-translate-y-0.5 hover:border-orange hover:shadow-md"
            >
              <div class="flex h-28 items-center justify-center border-b border-border bg-white">
                {card.shape === "slab" && (
                  <svg width="120" height="80" viewBox="0 0 120 80" fill="none" aria-hidden="true">
                    <rect x="20" y="16" width="80" height="48" rx="2" class="fill-orange/10 stroke-orange" stroke-width="2" />
                    <path d="M20 10v6M100 10v6M14 16h6M14 64h6" class="stroke-muted" stroke-width="1.5" />
                    <path d="M20 8h80" class="stroke-muted" stroke-width="1" stroke-dasharray="3 2" />
                  </svg>
                )}
                {card.shape === "driveway" && (
                  <svg width="120" height="80" viewBox="0 0 120 80" fill="none" aria-hidden="true">
                    <rect x="34" y="6" width="52" height="68" rx="2" class="fill-orange/10 stroke-orange" stroke-width="2" />
                    <path d="M34 4v-4M86 4v-4M28 6h6M28 74h6" class="stroke-muted" stroke-width="1.5" />
                    <path d="M34 2h52" class="stroke-muted" stroke-width="1" stroke-dasharray="3 2" />
                  </svg>
                )}
                {card.shape === "general" && (
                  <svg width="120" height="80" viewBox="0 0 120 80" fill="none" aria-hidden="true">
                    <rect x="14" y="14" width="46" height="34" rx="2" class="fill-orange/10 stroke-orange" stroke-width="2" />
                    <rect x="60" y="34" width="46" height="34" rx="2" class="fill-orange/15 stroke-orange" stroke-width="2" />
                  </svg>
                )}
              </div>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="font-semibold text-ink group-hover:text-orange">{card.title}</h3>
                <p class="mt-1.5 text-sm text-muted">{card.desc}</p>
                <p class="mt-2 text-xs font-medium text-muted">Useful for: {card.bestFor}</p>
                <span class="mt-3.5 inline-flex items-center gap-1 text-sm font-medium text-orange">
                  {card.cta}
                  <ArrowRight size={14} strokeWidth={2.5} aria-hidden="true" className="transition group-hover:translate-x-0.5" />
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. ALL CALCULATORS -->
    <section id="all-calculators" class="scroll-mt-20 border-b border-border bg-warm-white">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <h2 class="text-center text-2xl font-extrabold text-ink sm:text-3xl">All Free Concrete Calculators</h2>

        <div class="mx-auto mt-6 max-w-xl">
          <div class="relative">
            <Search size={16} className="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-muted" aria-hidden="true" />
            <input
              type="search"
              id="tool-search"
              placeholder="Search calculators..."
              aria-label="Search calculators"
              class="w-full rounded-lg border border-border bg-white py-2.5 pl-10 pr-4 text-sm text-ink placeholder:text-muted focus-visible:outline-2 focus-visible:outline-orange"
            />
          </div>
          <div class="mt-3 flex gap-2 overflow-x-auto pb-1" role="group" aria-label="Filter calculators">
            {filterChips.map((chip, i) => (
              <button
                type="button"
                data-filter-chip={chip.key}
                aria-pressed={i === 0 ? "true" : "false"}
                class="filter-chip shrink-0 rounded-full border border-border bg-white px-3.5 py-2 text-sm font-medium text-ink transition aria-pressed:border-orange aria-pressed:bg-orange aria-pressed:text-white"
              >
                {chip.label}
              </button>
            ))}
          </div>
        </div>

        <p id="no-results" hidden class="mt-8 text-center text-sm text-muted">No calculators match that search.</p>

        <div class="mt-10" data-tool-category>
          <h3 class="text-sm font-bold uppercase tracking-wide text-muted">Project calculators</h3>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" data-tool-grid>
            {projectTools.map((t) => (
              <a
                href={t.href}
                data-tool-card
                data-tool-name={t.title.toLowerCase()}
                data-tool-tags={t.tags.join(" ")}
                data-analytics-event="calculator_card_clicked"
                data-analytics-source={`directory_${t.href.replace("/", "")}`}
                class="group flex min-h-[44px] flex-col rounded-xl border border-border bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-orange hover:shadow-md"
              >
                <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-orange/10 text-orange transition group-hover:bg-orange group-hover:text-white">
                  {t.icon && <t.icon size={20} strokeWidth={2.25} aria-hidden="true" />}
                </span>
                <h4 class="mt-3.5 font-semibold text-ink group-hover:text-orange">{t.title}</h4>
                <p class="mt-1.5 text-sm text-muted">{t.outcome}</p>
                <p class="mt-2 text-xs font-medium text-muted">Best for: {t.bestFor}</p>
                <span class="mt-3.5 inline-flex items-center gap-1 text-sm font-medium text-orange">
                  Open calculator
                  <ArrowRight size={14} strokeWidth={2.5} aria-hidden="true" className="transition group-hover:translate-x-0.5" />
                </span>
              </a>
            ))}
          </div>
        </div>

        <div class="mt-10" data-tool-category>
          <h3 class="text-sm font-bold uppercase tracking-wide text-muted">Business calculators</h3>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" data-tool-grid>
            {businessTools.map((t) => (
              <a
                href={t.href}
                data-tool-card
                data-tool-name={t.title.toLowerCase()}
                data-tool-tags={t.tags.join(" ")}
                data-analytics-event="calculator_card_clicked"
                data-analytics-source={`directory_${t.href.replace("/", "")}`}
                class="group flex min-h-[44px] flex-col rounded-xl border border-border bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-orange hover:shadow-md"
              >
                <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-orange/10 text-orange transition group-hover:bg-orange group-hover:text-white">
                  {t.icon && <t.icon size={20} strokeWidth={2.25} aria-hidden="true" />}
                </span>
                <h4 class="mt-3.5 font-semibold text-ink group-hover:text-orange">{t.title}</h4>
                <p class="mt-1.5 text-sm text-muted">{t.outcome}</p>
                <p class="mt-2 text-xs font-medium text-muted">Best for: {t.bestFor}</p>
                <span class="mt-3.5 inline-flex items-center gap-1 text-sm font-medium text-orange">
                  Open calculator
                  <ArrowRight size={14} strokeWidth={2.5} aria-hidden="true" className="transition group-hover:translate-x-0.5" />
                </span>
              </a>
            ))}
          </div>
        </div>

        <div class="mt-10" data-tool-category>
          <h3 class="text-sm font-bold uppercase tracking-wide text-muted">Estimate tools</h3>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" data-tool-grid>
            {estimateTools.map((t) => (
              <a
                href={t.href}
                data-tool-card
                data-tool-name={t.title.toLowerCase()}
                data-tool-tags={t.tags.join(" ")}
                data-analytics-event="calculator_card_clicked"
                data-analytics-source={`directory_${t.href.replace("/", "")}`}
                class="group flex min-h-[44px] flex-col rounded-xl border border-border bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-orange hover:shadow-md"
              >
                <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-orange/10 text-orange transition group-hover:bg-orange group-hover:text-white">
                  {t.icon && <t.icon size={20} strokeWidth={2.25} aria-hidden="true" />}
                </span>
                <h4 class="mt-3.5 font-semibold text-ink group-hover:text-orange">{t.title}</h4>
                <p class="mt-1.5 text-sm text-muted">{t.outcome}</p>
                <p class="mt-2 text-xs font-medium text-muted">Best for: {t.bestFor}</p>
                <span class="mt-3.5 inline-flex items-center gap-1 text-sm font-medium text-orange">
                  Open calculator
                  <ArrowRight size={14} strokeWidth={2.5} aria-hidden="true" className="transition group-hover:translate-x-0.5" />
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 6. NATURAL FREE-TO-PRO BRIDGE -->
    <section class="border-b border-border bg-white">
      <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
        <h2 class="text-center text-2xl font-extrabold text-ink sm:text-3xl">A Free Calculator Prices One Project. Pro Builds a Repeatable Estimating System.</h2>
        <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div class="rounded-xl border border-border bg-warm-white p-5">
            <p class="text-xs font-bold uppercase tracking-wide text-muted">Free calculator</p>
            <ul class="mt-3 flex flex-col gap-2">
              {bridgeFree.map((item) => (
                <li class="flex items-start gap-2 text-sm text-ink/80">
                  <X size={15} className="mt-0.5 shrink-0 text-muted" aria-hidden="true" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="rounded-xl border border-orange/25 bg-orange/5 p-5">
            <p class="text-xs font-bold uppercase tracking-wide text-orange">Concrete Cost Pro</p>
            <ul class="mt-3 flex flex-col gap-2">
              {bridgePro.map((item) => (
                <li class="flex items-start gap-2 text-sm text-ink">
                  <Check size={15} className="mt-0.5 shrink-0 text-green" aria-hidden="true" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
