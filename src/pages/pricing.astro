---
import Layout from "../layouts/Layout.astro";
import PublicHeader from "../components/PublicHeader.astro";
import PublicFooter from "../components/PublicFooter.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import TrustBadges from "../components/TrustBadges.astro";
import PurchaseButton from "../components/PurchaseButton";

const includedGroups = [
  {
    title: "Estimate faster",
    path: "M13 2L3 14h7l-1 8 10-12h-7l1-8z",
    items: ["Saved costs, materials, labor and equipment catalog", "Reusable project templates", "Multi-section project estimating"],
  },
  {
    title: "Price with confidence",
    path: "M12 2l8 4v6c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6l8-4z M9 12l2 2 4-4",
    items: ["Overhead and target-margin pricing", "Rate Health audit and required-price solver", "Material, labor and equipment cost-change scenarios"],
  },
  {
    title: "Win and track the job",
    path: "M6 3h9l3 3v15H6V3z M15 3v3h3 M9 12h6 M9 15h6 M9 9h3",
    items: ["Branded, customer-ready estimate PDFs", "Estimate vs. actual job tracking", "Historical quantity and labor variance reports", "One-click estimate and project duplication"],
  },
  {
    title: "Your data, your control",
    path: "M12 2C6.5 2 2 4 2 6.5v11C2 20 6.5 22 12 22s10-2 10-4.5v-11C22 4 17.5 2 12 2z M2 6.5C2 9 6.5 11 12 11s10-2 10-4.5",
    items: ["Business profile with saved defaults", "CSV export and full JSON backup/restore", "No account required — runs in your browser", "No monthly subscription, ever"],
  },
];

const faqs = [
  {
    q: "Is $79 a permanent price?",
    a: "$79 is the launch price. Once launch pricing ends, new purchases move to the regular $99 price — but it's a one-time payment, not a subscription, so your price never changes after you buy. Buying now locks in $79 for as long as you use the product.",
  },
  {
    q: "Is this a subscription?",
    a: "No. Concrete Cost Pro is a one-time payment for lifetime access — no recurring billing, ever.",
  },
  {
    q: "Do I need an account?",
    a: "No account is required to use the app. Your data is stored locally in your browser, with export/import for backup or moving to a new device.",
  },
  {
    q: "Does this run in the cloud or on my computer?",
    a: "Concrete Cost Pro is local-first: everything runs in your browser and your data stays on your device. You control backups via JSON export.",
  },
  {
    q: "What if I switch computers?",
    a: "Export your workspace as a JSON file from Settings, then import it on the new device. Your catalog, templates, estimates and history all come with it.",
  },
];

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Concrete Cost Pro",
  description:
    "Concrete estimating and job-profitability software: quantities, true job costs, target-margin pricing, rate health and estimate-vs-actual reporting for concrete contractors.",
  offers: {
    "@type": "Offer",
    url: "https://concretecostpro.com/pricing",
    price: "79",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
  },
};
---

<Layout
  title="Pricing | Concrete Cost Pro"
  description="Concrete Cost Pro — $79 launch price (regularly $99), one-time payment for lifetime access. Saved rates, job costing, rate-health tracking, branded estimates and estimate-vs-actual reporting. No subscription."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(productSchema)} />
  </Fragment>
  <PublicHeader />
  <main>
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Pricing", href: "/pricing" }]} />
    <section class="border-b border-border bg-white">
      <div class="mx-auto max-w-3xl px-4 py-14 text-center sm:px-6">
        <h1 class="text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">One price. Every job, priced right.</h1>
        <p class="mt-3 text-lg text-muted">
          Concrete estimating and job-profitability software without another monthly contractor subscription.
        </p>
        <TrustBadges class="mt-6" />
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
      <div class="overflow-hidden rounded-2xl border-2 border-orange bg-white shadow-xl">
        <div class="relative overflow-hidden bg-charcoal px-6 py-9 text-center text-white sm:px-10">
          <div
            class="pointer-events-none absolute left-1/2 top-0 h-64 w-64 -translate-x-1/2 -translate-y-1/2 rounded-full bg-orange/25 blur-3xl"
            aria-hidden="true"
          >
          </div>
          <div class="relative">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-orange px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z" /></svg>
              Launch Price
            </span>
            <div class="text-sm font-semibold uppercase tracking-wide text-orange mt-3">Concrete Cost Pro</div>
            <div class="mt-2 flex items-end justify-center gap-3">
              <span class="pb-2 text-2xl font-medium text-white/40 line-through">$99</span>
              <span class="text-7xl font-extrabold tracking-tight">$79</span>
              <span class="pb-1.5 text-white/70">lifetime</span>
            </div>
            <p class="mt-2 text-sm font-semibold text-orange">Save $20 — launch pricing won't last</p>
            <p class="mt-1 text-sm text-white/60">
              One-time payment. Buy at $79 and that's your price for good — the regular price rises to $99 once launch
              pricing ends, but it never changes for you after you buy.
            </p>
          </div>
        </div>

        <div class="px-6 py-8 sm:px-10">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {includedGroups.map((group) => (
              <div class="rounded-xl border border-border bg-warm-white p-4">
                <div class="flex items-center gap-2 text-sm font-semibold text-ink">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-orange" aria-hidden="true">
                    <path d={group.path} stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {group.title}
                </div>
                <ul class="mt-2 space-y-1.5">
                  {group.items.map((item) => (
                    <li class="flex items-start gap-1.5 text-sm text-muted">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="mt-0.5 shrink-0 text-green" aria-hidden="true">
                        <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <div class="mt-6 flex items-start gap-3 rounded-xl border border-green/30 bg-green-light px-5 py-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 shrink-0 text-green" aria-hidden="true">
              <path d="M12 2l8 4v6c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6l8-4z" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <p class="text-sm text-ink">
              <strong>One underpriced job costs more than $79.</strong> Fix your pricing once, keep the difference on
              every job after.
            </p>
          </div>

          <div class="mt-6">
            <PurchaseButton client:load />
            <p class="mt-3 text-center text-xs text-muted">
              Free calculators are always available with no purchase — Pro adds saved data, job costing and
              estimate tracking.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
      <FaqAccordion faqs={faqs} title="Pricing questions" />
    </section>
  </main>
  <PublicFooter />
</Layout>
