---
import Layout from "../layouts/Layout.astro";
import PublicHeader from "../components/PublicHeader.astro";
import PublicFooter from "../components/PublicFooter.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import TrustBadges from "../components/TrustBadges.astro";
import PurchaseButton from "../components/PurchaseButton";
import LicenseRecovery from "../components/LicenseRecovery";
import { calculateMargin, calculateRequiredSellingPrice, formatCurrency } from "../lib/calc";

const beforeYouBuy = [
  { q: "What's included", a: "Saved rates, multi-section estimating, Rate Health, cost-change scenarios, branded PDFs, CSV export, estimate-vs-actual tracking and JSON backup. Full list below." },
  { q: "What happens after payment", a: "You're redirected back and unlocked immediately in the browser you paid from. A welcome email with your license key is also sent, for your records." },
  { q: "How access is delivered", a: "By license key, emailed to you and stored in the browser you purchased from. No account or password to set up." },
  { q: "Supported devices & browsers", a: "Any modern web browser, on any device: desktop, laptop, tablet or phone." },
  { q: "Data backup", a: "Settings → Export business data downloads a JSON file of your profile, catalog, rates and templates, importable on another device." },
  { q: "Switching computers", a: "Enter your license key (or use \"Forgot your key?\") to unlock the app on the new device, then import your JSON backup to bring your saved rates over." },
  { q: "Refund policy", a: "Email us within 14 days of purchase for a full refund, no questions asked. See the full refund policy." },
  { q: "Support", a: "Message us through the contact page. We read every message." },
];

const goodFit = [
  "You price more than one concrete job for customers, not just a single project",
  "You want overhead and target margin factored into every quote automatically",
  "You're comfortable with a browser-based tool that saves data on your device, not the cloud",
];

const notAFit = [
  "You need multiple people on different devices sharing the same saved data in real time",
  "You need blueprint/PDF takeoff, scheduling, CRM, accounting or payroll features",
  "You're pricing a single one-off project and don't need saved rates or repeat use (a free calculator is the better fit)",
];

// ROI illustration -- verified: a $12,000 price actually achieved at a 25% margin implies a
// true cost of $12,000 * (1 - 0.25) = $9,000. Pricing that same $9,000 true cost at a true 30%
// target margin requires $9,000 / (1 - 0.30) = $12,857.14. The difference is ~$857.
const roiExamplePrice = 12000;
const roiActualMarginPercent = 25;
const roiTargetMarginPercent = 30;
const roiTrueCost = roiExamplePrice * (1 - roiActualMarginPercent / 100);
const roiTargetPrice = calculateRequiredSellingPrice(roiTrueCost, roiTargetMarginPercent);
const roiDifference = roiTargetPrice - roiExamplePrice;
const roiActualMarginCheck = calculateMargin(roiExamplePrice, roiTrueCost);

const includedGroups = [
  {
    title: "Estimate faster",
    path: "M13 2L3 14h7l-1 8 10-12h-7l1-8z",
    items: ["Saved costs, materials, labor and equipment catalog", "Reusable project templates", "Multi-section project estimating"],
  },
  {
    title: "Price with confidence",
    path: "M12 2l8 4v6c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6l8-4z M9 12l2 2 4-4",
    items: ["Overhead and target-margin pricing", "Rate Health audit and required-price solver", "Material, labor and equipment cost-change scenarios"],
  },
  {
    title: "Document and track the job",
    path: "M6 3h9l3 3v15H6V3z M15 3v3h3 M9 12h6 M9 15h6 M9 9h3",
    items: ["Branded, customer-ready estimate PDFs", "Current estimate vs. actual job tracking", "Contractor-facing CSV export for your records", "One-click duplication to start a new estimate from the current one"],
  },
  {
    title: "Your data, your control",
    path: "M12 2C6.5 2 2 4 2 6.5v11C2 20 6.5 22 12 22s10-2 10-4.5v-11C22 4 17.5 2 12 2z M2 6.5C2 9 6.5 11 12 11s10-2 10-4.5",
    items: ["Business profile with saved defaults", "One-click backup of your catalog, rates and templates", "No account required, runs in your browser", "No monthly subscription, ever"],
  },
];

// Trimmed to what "Before you buy" above doesn't already answer -- account, cloud/device,
// switching computers and subscription status are all covered there, so repeating them here
// would just be the same claim twice.
const faqs = [
  {
    q: "Is $79 a permanent price?",
    a: "$79 is the launch price. Once launch pricing ends, new purchases move to the regular $99 price, but it's a one-time payment, not a subscription, so your price never changes after you buy. Buying now locks in $79 for as long as you use the product.",
  },
  {
    q: "Does Concrete Cost Pro keep a history of my past estimates?",
    a: "No. Concrete Cost Pro keeps exactly one current estimate at a time, autosaved on this device. Starting a new estimate replaces it after you confirm; download a PDF or CSV first if you want to keep a copy. There is no estimate archive or project history inside the app.",
  },
];

// This is the site's one Product entity (for Google Merchant Listings) -- the free
// calculators' WebApplication schema elsewhere carries its own unrelated $0 Offer, not a
// Product. Keep it that way: only this page should ever declare a Product.
//
// Real screenshots of the actual app, already shown on this page below -- see the
// "A few of the tools included" section for the same three images with their own alt text.
const productImages = [
  "https://concretecostpro.com/guide/09-estimate-summary.png",
  "https://concretecostpro.com/guide/10-rate-health.png",
  "https://concretecostpro.com/guide/04-templates.png",
];

// No `review`/`aggregateRating`: there are no real customer reviews yet, and fabricating
// either would violate Google's structured-data policy. Add them only once genuine reviews
// exist and are visibly published on this page. The resulting Search Console warning is a
// non-critical recommendation, not an indexing blocker.
//
// No `shippingDetails`: Concrete Cost Pro is unlocked in-browser after checkout, nothing is
// physically shipped, so there's no truthful shipping information to declare. Left
// unresolved intentionally rather than fabricate free-shipping data for a digital product.
const productSchema = {
  "@context": "https://schema.org",
  "@type": ["Product", "SoftwareApplication"],
  "@id": "https://concretecostpro.com/pricing/#product",
  name: "Concrete Cost Pro",
  description:
    "Concrete estimating and job-profitability software: quantities, true job costs, target-margin pricing, rate health and estimate-vs-actual reporting for concrete contractors.",
  url: "https://concretecostpro.com/pricing/",
  image: productImages,
  brand: { "@type": "Brand", name: "Concrete Cost Pro" },
  sku: "CONCRETE-COST-PRO",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Modern web browser",
  offers: {
    "@type": "Offer",
    url: "https://concretecostpro.com/pricing/",
    price: "79.00",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
    seller: {
      "@type": "Organization",
      "@id": "https://concretecostpro.com/#organization",
      name: "Concrete Cost Pro",
      url: "https://concretecostpro.com/",
    },
    hasMerchantReturnPolicy: {
      "@type": "MerchantReturnPolicy",
      merchantReturnLink: "https://concretecostpro.com/refund/",
    },
  },
};
---

<Layout
  title="Pricing | Concrete Cost Pro"
  description="Concrete Cost Pro: $79 launch price (regularly $99), one-time payment for lifetime access. Saved rates, job costing, rate-health tracking, branded estimates and estimate-vs-actual reporting. No subscription."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(productSchema)} />
  </Fragment>
  <PublicHeader />
  <main>
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Pricing", href: "/pricing" }]} />
    <section class="border-b border-border bg-white">
      <div class="mx-auto max-w-3xl px-4 py-14 text-center sm:px-6">
        <h1 class="text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">One price. Every job, priced right.</h1>
        <p class="mt-3 text-lg text-muted">
          Concrete estimating and job-profitability software without another monthly contractor subscription.
        </p>
        <TrustBadges class="mt-6" />
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
      <div class="overflow-hidden rounded-2xl border-2 border-orange bg-white shadow-xl">
        <div class="relative overflow-hidden bg-charcoal px-6 py-9 text-center text-white sm:px-10">
          <div
            class="pointer-events-none absolute left-1/2 top-0 h-64 w-64 -translate-x-1/2 -translate-y-1/2 rounded-full bg-orange/25 blur-3xl"
            aria-hidden="true"
          >
          </div>
          <div class="relative">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-orange px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z" /></svg>
              Launch Price
            </span>
            <div class="text-sm font-semibold uppercase tracking-wide text-orange-ondark mt-3">Concrete Cost Pro</div>
            <div class="mt-2 flex items-end justify-center gap-3">
              <span class="pb-2 text-2xl font-medium text-white/55 line-through">$99</span>
              <span class="text-7xl font-extrabold tracking-tight">$79</span>
              <span class="pb-1.5 text-white/70">lifetime</span>
            </div>
            <p class="mt-2 text-sm font-semibold text-orange-ondark">$79 one-time purchase. No monthly subscription.</p>
            <p class="mt-1 text-sm text-white/60">
              Current launch price: $79. Planned regular price: $99. Buy at $79 and that's your price for good; it
              never changes for you after you buy, even once launch pricing ends.
            </p>
          </div>
        </div>

        <div class="px-6 py-8 sm:px-10">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {includedGroups.map((group) => (
              <div class="rounded-xl border border-border bg-warm-white p-4">
                <div class="flex items-center gap-2 text-sm font-semibold text-ink">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-orange" aria-hidden="true">
                    <path d={group.path} stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {group.title}
                </div>
                <ul class="mt-2 space-y-1.5">
                  {group.items.map((item) => (
                    <li class="flex items-start gap-1.5 text-sm text-muted">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="mt-0.5 shrink-0 text-green" aria-hidden="true">
                        <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <div class="mt-6 flex items-start gap-3 rounded-xl border border-green/30 bg-green-light px-5 py-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 shrink-0 text-green" aria-hidden="true">
              <path d="M12 2l8 4v6c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6l8-4z" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <p class="text-sm text-ink">
              <strong>One underpriced job costs more than $79.</strong> Fix your pricing once, keep the difference on
              every job after.
            </p>
          </div>

          <div class="mt-6">
            <PurchaseButton client:load />
            <p class="mt-3 text-center text-xs text-muted">
              Free calculators are always available with no purchase. Pro adds saved data, job costing and
              estimate tracking.
            </p>
            <p class="mt-2 text-center text-xs text-muted">
              By purchasing, you agree to our <a href="/terms" class="underline hover:text-orange">Terms</a> and{" "}
              <a href="/refund" class="underline hover:text-orange">Refund Policy</a>.
            </p>
            <LicenseRecovery client:load />
          </div>
        </div>
      </div>
    </section>

    <!-- Everything a buyer needs to know before checkout, verified against the actual product
         and policies rather than assumed. -->
    <section class="mx-auto max-w-4xl px-4 pb-14 sm:px-6">
      <h2 class="text-center text-xl font-bold text-ink">Before you buy</h2>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {beforeYouBuy.map((item) => (
          <div class="rounded-xl border border-border bg-white p-4">
            <h3 class="text-sm font-semibold text-ink">{item.q}</h3>
            <p class="mt-1 text-sm text-muted">{item.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Free vs Pro, condensed -- the full feature-by-feature table lives on the software page;
         this one is scoped to the handful of differences that actually drive the purchase
         decision. -->
    <section class="border-t border-border bg-white">
      <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
        <h2 class="text-center text-2xl font-extrabold text-ink sm:text-3xl">Free vs. Pro, the short version</h2>
        <div class="mt-8 overflow-hidden rounded-xl border border-border shadow-sm">
          <div class="overflow-x-auto">
            <table class="w-full min-w-[480px] text-left text-sm">
              <thead>
                <tr class="border-b border-border bg-warm-white text-xs uppercase tracking-wide text-muted">
                  <th class="px-4 py-3 font-medium">Free calculators</th>
                  <th class="px-4 py-3 font-medium">Concrete Cost Pro</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <tr>
                  <td class="px-4 py-3 align-top text-muted">Calculate one project's quantity, cost and required price</td>
                  <td class="px-4 py-3 align-top text-ink">All of that, plus your rates saved for next time</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 align-top text-muted">Re-enter materials, labor and equipment costs every visit</td>
                  <td class="px-4 py-3 align-top text-ink">Saved catalog and business defaults, filled in automatically</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 align-top text-muted">One project at a time, nothing saved</td>
                  <td class="px-4 py-3 align-top text-ink">Reusable templates, saved estimates, one-click duplication</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 align-top text-muted">No audit of your existing standard rates</td>
                  <td class="px-4 py-3 align-top text-ink">Rate Health flags any standard rate below target margin</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 align-top text-muted">Print or save a document you build by hand</td>
                  <td class="px-4 py-3 align-top text-ink">Branded PDF, CSV export, and estimate-vs-actual tracking</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Good fit / not a fit -->
    <section class="border-t border-border bg-warm-white">
      <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div class="rounded-xl border border-green/25 bg-white p-5">
            <h2 class="font-semibold text-ink">Good fit if…</h2>
            <ul class="mt-3 flex flex-col gap-2">
              {goodFit.map((item) => (
                <li class="text-sm text-ink/80">{item}</li>
              ))}
            </ul>
          </div>
          <div class="rounded-xl border border-border bg-white p-5">
            <h2 class="font-semibold text-ink">Not a fit if…</h2>
            <ul class="mt-3 flex flex-col gap-2">
              {notAFit.map((item) => (
                <li class="text-sm text-ink/80">{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Illustrative ROI example -- math shown in full, not just asserted. -->
    <section class="border-t border-border bg-white">
      <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
        <div class="mx-auto max-w-xl text-center">
          <p class="text-xs font-bold uppercase tracking-wider text-orange">Illustrative example, not a promised saving</p>
          <h2 class="mt-2 text-2xl font-extrabold text-ink sm:text-3xl">What one margin mix-up is worth</h2>
        </div>
        <div class="mt-8 rounded-xl border border-border bg-warm-white p-6">
          <p class="text-sm text-ink/80">
            Say a {formatCurrency(roiExamplePrice, { cents: false })} job was actually priced at a {roiActualMarginPercent}% margin
            (true cost {formatCurrency(roiTrueCost, { cents: false })}) instead of the contractor's real {roiTargetMarginPercent}% target.
            Pricing that same {formatCurrency(roiTrueCost, { cents: false })} true cost at a true {roiTargetMarginPercent}% margin
            requires {formatCurrency(roiTargetPrice, { cents: true })} — a difference of about{" "}
            <strong class="text-ink">{formatCurrency(roiDifference, { cents: false })}</strong> on this one job.
          </p>
          <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div class="rounded-lg border border-border bg-white p-3 text-center">
              <div class="text-xs text-muted">Priced at {roiActualMarginPercent}% margin</div>
              <div class="text-lg font-bold text-ink">{formatCurrency(roiExamplePrice, { cents: false })}</div>
            </div>
            <div class="rounded-lg border border-border bg-white p-3 text-center">
              <div class="text-xs text-muted">Priced at {roiTargetMarginPercent}% margin</div>
              <div class="text-lg font-bold text-ink">{formatCurrency(roiTargetPrice, { cents: true })}</div>
            </div>
            <div class="rounded-lg border border-green/30 bg-green-light p-3 text-center">
              <div class="text-xs text-muted">Difference</div>
              <div class="text-lg font-bold text-green">{formatCurrency(roiDifference, { cents: false })}</div>
            </div>
          </div>
          <p class="mt-4 text-xs text-muted">
            Illustrative only: this is one example calculation, not a projection of your results. Verify: at{" "}
            {formatCurrency(roiExamplePrice, { cents: false })} against a {formatCurrency(roiTrueCost, { cents: false })} true cost,
            the margin is {roiActualMarginCheck !== null ? Math.round(roiActualMarginCheck * 100) : "—"}%, confirming the {roiActualMarginPercent}%
            starting point above.
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-border bg-warm-white">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <div class="mx-auto max-w-xl text-center">
          <p class="text-xs font-bold uppercase tracking-wider text-orange">See it before you buy</p>
          <h2 class="mt-2 text-2xl font-extrabold text-ink sm:text-3xl">A few of the tools included</h2>
          <p class="mt-3 text-muted">
            Everything above (rates, templates, estimates, tracking) is real software, not just a feature list.
            Here's a sample of it.
          </p>
        </div>
        <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
          {[
            {
              img: "/guide/10-rate-health.png",
              alt: "Rate Health dashboard showing standard concrete rates flagged below target margin, with required price shown for each",
              caption: "Rate Health flags underpriced standard rates",
            },
            {
              img: "/guide/09-estimate-summary.png",
              alt: "Branded customer estimate document next to an internal cost, overhead and margin panel",
              caption: "Branded estimates, cost and margin kept private",
            },
            {
              img: "/guide/04-templates.png",
              alt: "Saved project templates for standard job types, each showing order quantity, true cost and margin status",
              caption: "Reusable templates for your standard jobs",
            },
          ].map((shot) => (
            <div class="overflow-hidden rounded-xl border border-border bg-white shadow-sm">
              <div class="flex items-center gap-1.5 border-b border-border bg-warm-white px-3 py-2.5">
                <span class="h-2.5 w-2.5 rounded-full bg-red/50" aria-hidden="true"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-amber/50" aria-hidden="true"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-green/50" aria-hidden="true"></span>
              </div>
              <img src={shot.img} alt={shot.alt} loading="lazy" class="w-full border-b border-border" />
              <p class="px-4 py-3 text-sm font-medium text-ink">{shot.caption}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
      <FaqAccordion faqs={faqs} title="Pricing questions" />
    </section>
  </main>
  <PublicFooter />
</Layout>
