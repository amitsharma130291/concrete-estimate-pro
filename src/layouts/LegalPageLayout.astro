---
import Layout from "./Layout.astro";
import PublicHeader from "../components/PublicHeader.astro";
import PublicFooter from "../components/PublicFooter.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

export interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<Layout title={`${title} | Concrete Cost Pro`} description={description}>
  <PublicHeader />
  <main>
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: title, href: Astro.url.pathname }]} />
    <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-14">
      <h1 class="text-3xl font-extrabold tracking-tight text-ink">{title}</h1>
      <p class="mt-2 text-sm text-muted">Last updated {updated}</p>
      <div class="legal-content mt-8 flex flex-col gap-5 text-sm leading-relaxed text-ink">
        <slot />
      </div>
    </section>
  </main>
  <PublicFooter />
</Layout>

<style>
  .legal-content :global(h2) {
    margin-top: 1rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .legal-content :global(p) {
    color: var(--color-ink);
  }
  .legal-content :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .legal-content :global(a) {
    color: var(--color-orange);
    text-decoration: underline;
  }
  .legal-content :global(strong) {
    color: var(--color-ink);
  }
</style>
