---
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  noIndex?: boolean;
}

const { title, description, noIndex = false } = Astro.props;
const site = Astro.site ?? new URL("https://concretecostpro.com");
const canonicalURL = new URL(Astro.url.pathname, site);

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Concrete Cost Pro",
  url: site.toString(),
  potentialAction: {
    "@type": "SearchAction",
    target: `${site.toString().replace(/\/$/, "")}/?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};

const absoluteUrl = (path: string) => new URL(path, site).toString();

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Concrete Cost Pro",
  url: site.toString(),
  logo: absoluteUrl("/icon-512.png"),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Concrete Cost Pro" />
    <meta property="og:image" content={absoluteUrl("/brand/logo-header.png")} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    {!noIndex && (
      <>
        <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
        <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
      </>
    )}
    <slot name="head" />
  </head>
  <body class="bg-warm-white text-ink antialiased">
    <slot />
  </body>
</html>
