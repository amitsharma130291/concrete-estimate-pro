---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { ArrowUp } from "lucide-react";

export interface Props {
  title: string;
  description: string;
  noIndex?: boolean;
  /** Opt-in soft (client-side) navigation -- only the /app/* dashboard pages set this. Astro's
   * ClientRouter only does a soft swap between two pages that BOTH include it, so every public
   * marketing page (none of which set this) still gets a normal hard navigation, unaffected. */
  softNav?: boolean;
}

const { title, description, noIndex = false, softNav = false } = Astro.props;
// Back-to-top button: only on the /app dashboard, where several tabs (Catalog, Templates)
// can genuinely grow long. The public marketing pages don't get it, since they already have
// plenty of scroll-triggered fixed elements (calculator sticky bars, contextual CTAs).
const showBackToTop = Astro.url.pathname === "/app" || Astro.url.pathname.startsWith("/app/");
const site = Astro.site ?? new URL("https://concretecostpro.com");
const canonicalURL = new URL(Astro.url.pathname, site);

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Concrete Cost Pro",
  url: site.toString(),
  potentialAction: {
    "@type": "SearchAction",
    target: `${site.toString().replace(/\/$/, "")}/?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};

const absoluteUrl = (path: string) => new URL(path, site).toString();

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${site.toString()}#organization`,
  name: "Concrete Cost Pro",
  url: site.toString(),
  logo: absoluteUrl("/icon-512.png"),
  hasMerchantReturnPolicy: {
    "@type": "MerchantReturnPolicy",
    merchantReturnLink: absoluteUrl("/refund/"),
  },
};

// GA4 measurement IDs are public client-side identifiers, not secrets -- safe to bake in
// directly rather than depend on the Vercel PUBLIC_GA_MEASUREMENT_ID env var resolving.
const GA_MEASUREMENT_ID = "G-F30VHD9PN2";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {softNav && <ClientRouter />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Concrete Cost Pro" />
    <meta property="og:image" content={absoluteUrl("/brand/logo-header.png")} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    {!noIndex && (
      <>
        <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
        <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
      </>
    )}
    {GA_MEASUREMENT_ID && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag("js", new Date());
          gtag("config", GA_MEASUREMENT_ID);
        </script>
      </>
    )}
    <slot name="head" />
  </head>
  <body class="bg-warm-white text-ink antialiased">
    <slot />
    {showBackToTop && (
      <button
        type="button"
        id="back-to-top"
        hidden
        aria-label="Back to top"
        class="fixed bottom-6 right-6 z-40 hidden h-11 w-11 items-center justify-center rounded-full bg-orange text-white shadow-lg transition hover:bg-orange-dark focus-visible:outline-2 focus-visible:outline-offset-2 md:flex"
      >
        <ArrowUp size={20} aria-hidden="true" />
      </button>
    )}
    <script>
      import { initAnalyticsDelegation } from "../lib/analytics";
      import { initPricingCtaSwap } from "../lib/pricingCtaSwap";
      import { initBackToTop } from "../lib/backToTop";
      initAnalyticsDelegation();
      initPricingCtaSwap();
      initBackToTop();
    </script>
  </body>
</html>
