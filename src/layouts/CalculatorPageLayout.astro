---
import Layout from "./Layout.astro";
import PublicHeader from "../components/PublicHeader.astro";
import PublicFooter from "../components/PublicFooter.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import TrustBadges from "../components/TrustBadges.astro";
import ProjectCalculatorIsland from "../components/calculator/ProjectCalculatorIsland";
import { CALCULATOR_CONFIGS, type CalculatorConfig } from "../data/calculatorConfigs";

export interface Props {
  config: CalculatorConfig;
}
const { config } = Astro.props;

// Every calculator links to the other project-type calculators and to the general
// calculator + job cost calculator, per the internal-linking pattern in the launch plan.
const relatedCalculators = Object.values(CALCULATOR_CONFIGS)
  .filter((c) => c.slug !== config.slug)
  .sort((a, b) => (a.projectType === "general" ? -1 : b.projectType === "general" ? 1 : 0));

const webApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: config.h1,
  url: `https://concretecostpro.com/${config.slug}`,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (web browser)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description: config.metaDescription,
};

const noun =
  config.h1
    .replace(/^Concrete\s+/i, "")
    .replace(/\s*Cost Calculator\s*$/i, "")
    .replace(/\s*Calculator\s*$/i, "")
    .trim() || "project";
---

<Layout title={`${config.h1} | Concrete Cost Pro`} description={config.metaDescription}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webApplicationSchema)} />
  </Fragment>
  <PublicHeader />
  <main>
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Calculators", href: "/calculators" },
        { label: config.h1, href: `/${config.slug}` },
      ]}
    />

    <!-- Compact hero — kept short on purpose so the calculator sits as close to the fold as possible. -->
    <section class="border-b border-border bg-white">
      <div class="mx-auto max-w-7xl px-4 pb-5 pt-5 sm:px-6 sm:pb-6 sm:pt-6">
        <h1 class="text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">{config.h1}</h1>
        <p class="mt-1.5 max-w-2xl text-base text-muted">{config.intro}</p>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8">
      <ProjectCalculatorIsland config={config} client:load />
    </section>

    <section class="border-y border-border bg-white">
      <div class="mx-auto max-w-7xl px-4 py-5 sm:px-6">
        <TrustBadges />
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
      <h2 class="text-2xl font-bold text-ink">What affects the cost of a concrete {noun.toLowerCase()}</h2>
      <p class="mt-2 text-muted">
        The calculator above gives you a real number from your own inputs — here's what typically drives those
        numbers up or down, so you know what to look for on your specific job.
      </p>
      <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
        {config.costFactors.map((f) => (
          <div>
            <h3 class="font-semibold text-ink">{f.title}</h3>
            <p class="mt-1 text-sm text-muted">{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="border-t border-border bg-white">
      <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
        <h2 class="text-xl font-bold text-ink">How this calculator works</h2>
        <ol class="mt-4 flex flex-col gap-3 text-sm text-muted">
          <li class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-orange/10 text-xs font-bold text-orange">1</span>
            <span><strong class="text-ink">Area</strong> — {config.length.label.toLowerCase()} × {config.width.label.toLowerCase()} gives the footprint in square feet.</span>
          </li>
          <li class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-orange/10 text-xs font-bold text-orange">2</span>
            <span><strong class="text-ink">Volume</strong> — area × {config.thickness.label.toLowerCase()} (converted to feet) gives cubic feet, divided by 27 to get cubic yards.</span>
          </li>
          <li class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-orange/10 text-xs font-bold text-orange">3</span>
            <span><strong class="text-ink">Order quantity</strong> — your allowance percentage is added on top so you don't come up short on pour day, then rounded to whatever increment you choose.</span>
          </li>
          <li class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-orange/10 text-xs font-bold text-orange">4</span>
            <span><strong class="text-ink">Cost and price</strong> — ready-mix, labor, forms, reinforcement and equipment costs are totaled, overhead is added for true cost, and the required price is solved for your target margin.</span>
          </li>
        </ol>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
      <FaqAccordion faqs={config.faqs} />
    </section>

    <section class="border-t border-border bg-white">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
        <h2 class="text-xl font-bold text-ink">Related concrete calculators</h2>
        <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {relatedCalculators.map((c) => (
            <a
              href={`/${c.slug}`}
              class="rounded-lg border border-border bg-warm-white px-4 py-3 text-sm font-medium text-ink transition hover:border-orange hover:text-orange"
            >
              {c.h1}
            </a>
          ))}
          <a
            href="/concrete-job-cost-calculator"
            class="rounded-lg border border-border bg-warm-white px-4 py-3 text-sm font-medium text-ink transition hover:border-orange hover:text-orange"
          >
            Concrete Job Cost Calculator
          </a>
        </div>
      </div>
    </section>

    <section class="bg-charcoal">
      <div class="mx-auto max-w-4xl px-4 py-14 text-center sm:px-6">
        <h2 class="text-2xl font-bold text-white sm:text-3xl">Ready to run every job at a healthy margin?</h2>
        <p class="mx-auto mt-3 max-w-xl text-white/70">
          Concrete Cost Pro saves your rates, prices full jobs, and flags underpriced work before you send the
          quote.
        </p>
        <p class="mt-4 text-sm text-orange-ondark">
          <span class="text-white/55 line-through">$99</span> $79 launch price — locks in for good, one time only
        </p>
        <a
          href="/pricing"
          data-pricing-cta
          data-analytics-event="pro_cta_clicked"
          data-analytics-source={`calculator_${config.slug}`}
          class="mt-3 inline-flex items-center justify-center rounded-lg bg-orange px-6 py-3.5 text-base font-semibold text-white transition hover:bg-orange-dark"
        >
          Get Concrete Cost Pro — $79 Launch Price
        </a>
      </div>
    </section>
  </main>
  <PublicFooter />
</Layout>
