---
import Layout from "./Layout.astro";
import PublicHeader from "../components/PublicHeader.astro";
import PublicFooter from "../components/PublicFooter.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ProjectCalculatorIsland from "../components/calculator/ProjectCalculatorIsland";
import { CALCULATOR_CONFIGS, type CalculatorConfig } from "../data/calculatorConfigs";

export interface Props {
  config: CalculatorConfig;
}
const { config } = Astro.props;

const features = [
  {
    title: "Price with confidence",
    desc: "Know your costs. Protect your margin.",
    path: "M12 2l2.6 5.3 5.8.8-4.2 4.1 1 5.8L12 15l-5.2 2.9 1-5.8-4.2-4.1 5.8-.8L12 2z",
  },
  {
    title: "Win more jobs",
    desc: "Professional estimates build trust.",
    path: "M6 3h9l3 3v15H6V3z M15 3v3h3 M9 12h6 M9 15h6 M9 9h3",
  },
  {
    title: "Built for contractors",
    desc: "Simple. Fast. Reliable.",
    path: "M3 12l2-2 4 4L19 4l2 2-12 12z",
  },
];

// Every calculator links to the other project-type calculators and to the general
// calculator + job cost calculator, per the internal-linking pattern in the launch plan.
const relatedCalculators = Object.values(CALCULATOR_CONFIGS)
  .filter((c) => c.slug !== config.slug)
  .sort((a, b) => (a.projectType === "general" ? -1 : b.projectType === "general" ? 1 : 0));

const webApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: config.h1,
  url: `https://concretecostpro.com/${config.slug}`,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (web browser)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description: config.metaDescription,
};
---

<Layout title={`${config.h1} | Concrete Cost Pro`} description={config.metaDescription}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webApplicationSchema)} />
  </Fragment>
  <PublicHeader />
  <main>
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Calculators", href: "/calculators" },
        { label: config.h1, href: `/${config.slug}` },
      ]}
    />
    <section class="border-b border-border bg-white">
      <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-12">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div class="max-w-2xl">
            <h1 class="text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">{config.h1}</h1>
            <p class="mt-3 text-lg text-muted">{config.intro}</p>
          </div>
          <ul class="flex shrink-0 flex-col gap-1.5 border-l-2 border-orange pl-4 text-sm font-medium text-ink">
            <li>Accurate Estimates</li>
            <li>Stronger Margins</li>
            <li>More Winning Jobs</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10">
      <ProjectCalculatorIsland config={config} client:load />
    </section>

    <section class="border-y border-border bg-white">
      <div class="mx-auto grid max-w-7xl grid-cols-1 gap-6 px-4 py-10 sm:grid-cols-3 sm:px-6">
        {features.map((f) => (
          <div class="flex items-start gap-3">
            <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-orange/10 text-orange">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d={f.path} stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <div>
              <div class="font-semibold text-ink">{f.title}</div>
              <div class="text-sm text-muted">{f.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
      <FaqAccordion faqs={config.faqs} />
    </section>

    <section class="border-t border-border bg-white">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
        <h2 class="text-xl font-bold text-ink">Related concrete calculators</h2>
        <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {relatedCalculators.map((c) => (
            <a
              href={`/${c.slug}`}
              class="rounded-lg border border-border bg-warm-white px-4 py-3 text-sm font-medium text-ink transition hover:border-orange hover:text-orange"
            >
              {c.h1}
            </a>
          ))}
          <a
            href="/concrete-job-cost-calculator"
            class="rounded-lg border border-border bg-warm-white px-4 py-3 text-sm font-medium text-ink transition hover:border-orange hover:text-orange"
          >
            Concrete Job Cost Calculator
          </a>
        </div>
      </div>
    </section>

    <section class="bg-charcoal">
      <div class="mx-auto max-w-4xl px-4 py-14 text-center sm:px-6">
        <h2 class="text-2xl font-bold text-white sm:text-3xl">Ready to run every job at a healthy margin?</h2>
        <p class="mx-auto mt-3 max-w-xl text-white/70">
          Concrete Cost Pro saves your rates, prices full jobs, and flags underpriced work before you send the
          quote.
        </p>
        <p class="mt-4 text-sm text-orange">
          <span class="text-white/40 line-through">$99</span> $79 launch price — locks in for good, one time only
        </p>
        <a
          href="/pricing"
          class="mt-3 inline-flex items-center justify-center rounded-lg bg-orange px-6 py-3.5 text-base font-semibold text-white transition hover:bg-orange-dark"
        >
          Get Concrete Cost Pro — $79 Launch Price
        </a>
      </div>
    </section>
  </main>
  <PublicFooter />
</Layout>
